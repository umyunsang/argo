\PYG{l+s+s2}{        You are going to compare two natural\PYGZhy{}language hypotheses HypoA and HypoB accompanied with optional workflows: WorkflowA for HypoA and WorkflowB for HypoB.}
\PYG{l+s+s2}{        Both the hypotheses answer the natural language query \PYGZdq{}QUERY\PYGZdq{} over the dataset(s) described by dataset description(s) and column description(s) below.}
\PYG{l+s+s2}{        Compare HypoA and HypoB in terms of three aspects: Contexts, Variables, and Relations.}
\PYG{l+s+s2}{        E.g., for the hypothesis \PYGZdq{}From 1995 to 2009, the number of sandhill cranes around the tundra (Indigilka River) surged by an astounding \PYGZti{}10X\PYGZdq{}:}
\PYG{l+s+s2}{        * Contexts refer to the stratification of the data under which the given hypothesis is True. E.g., \PYGZdq{}For all women\PYGZdq{}, \PYGZdq{}From 1995 to 2009\PYGZdq{}.}
\PYG{l+s+s2}{        * Variables refer to the set of variables (either dependent or independent) that are mentioned in the hypothesis. E.g., number of sandhill cranes, location.}
\PYG{l+s+s2}{        * Relations refer to the form of relation between the variables. E.g., \PYGZdq{}surged by \PYGZti{}10x\PYGZdq{}.}

\PYG{l+s+s2}{        Answer the following questions for a given pair of hypotheses, HypoA and HypoB, along with an explanation grounded on the QUERY and the DATASET(S).}

\PYG{l+s+s2}{        Here is the metadata for the task:}
\PYG{l+s+s2}{        ```json}
\PYG{l+s+s2}{        }\PYG{l+s+se}{\PYGZob{}\PYGZob{}}
\PYG{l+s+s2}{        \PYGZdq{}datasets\PYGZdq{}: }\PYG{l+s+si}{\PYGZob{}}\PYG{n}{datasets\PYGZus{}json}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+s2}{,}
\PYG{l+s+s2}{        \PYGZdq{}query\PYGZdq{}: }\PYG{l+s+si}{\PYGZob{}}\PYG{n}{query}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+s2}{,}
\PYG{l+s+s2}{        \PYGZdq{}HypoA\PYGZdq{}: }\PYG{l+s+si}{\PYGZob{}}\PYG{n}{gold\PYGZus{}hypo}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+s2}{,}
\PYG{l+s+s2}{        \PYGZdq{}WorkflowA\PYGZdq{}: }\PYG{l+s+si}{\PYGZob{}}\PYG{n}{gold\PYGZus{}workflow}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+s2}{,}
\PYG{l+s+s2}{        \PYGZdq{}HypoB\PYGZdq{}: }\PYG{l+s+si}{\PYGZob{}}\PYG{n}{gen\PYGZus{}hypo}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+s2}{,}
\PYG{l+s+s2}{        \PYGZdq{}WorkflowB\PYGZdq{}: }\PYG{l+s+si}{\PYGZob{}}\PYG{n}{gen\PYGZus{}workflow}\PYG{l+s+si}{\PYGZcb{}}
\PYG{l+s+s2}{        }\PYG{l+s+se}{\PYGZcb{}\PYGZcb{}}
\PYG{l+s+s2}{        ```}

\PYG{l+s+s2}{        }\PYG{l+s+si}{\PYGZob{}}\PYG{n}{variable\PYGZus{}question}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+s2}{\PYGZdq{}\PYGZdq{}\PYGZdq{}}
\PYG{n}{dimension\PYGZus{}question} \PYG{o}{=} \PYG{l+s+s2}{\PYGZdq{}\PYGZdq{}\PYGZdq{}}
\PYG{l+s+s2}{        Question: Does HypoB exhibit the same relation as HypoA?}
\PYG{l+s+s2}{        Compare using the following example hierarchy of relationships (based on specificity): }\PYG{l+s+se}{\PYGZbs{}}
\PYG{l+s+s2}{        \PYGZdq{}there exists a relationship\PYGZdq{} \PYGZgt{} \PYGZdq{}positive relationship\PYGZdq{} \PYGZgt{} \PYGZdq{}positive AND (linear OR quadratic)\PYGZdq{} \PYGZgt{} \PYGZdq{}positive AND linear.\PYGZdq{}}
\PYG{l+s+s2}{        Options: A) very similar B) similar but general than HypoA C) different}
