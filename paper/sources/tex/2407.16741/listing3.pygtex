\PYG{l+s+sd}{    Backquote, Minus, Equal, Backslash, Backspace, Tab, Delete, Escape,}
\PYG{l+s+sd}{    ArrowDown, End, Enter, Home, Insert, PageDown, PageUp, ArrowRight,}
\PYG{l+s+sd}{    ArrowUp, F1 \PYGZhy{} F12, Digit0 \PYGZhy{} Digit9, KeyA \PYGZhy{} KeyZ, etc. You can}
\PYG{l+s+sd}{    alternatively specify a single character you\PYGZsq{}d like to produce such}
\PYG{l+s+sd}{    as \PYGZdq{}a\PYGZdq{} or \PYGZdq{}\PYGZsh{}\PYGZdq{}. Following modification shortcuts are also supported:}
\PYG{l+s+sd}{    Shift, Control, Alt, Meta.}

\PYG{l+s+sd}{    Examples:}
