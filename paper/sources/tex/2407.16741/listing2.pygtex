\PYG{k}{def} \PYG{n+nf}{edit\PYGZus{}file}\PYG{p}{(}\PYG{n}{start}\PYG{p}{:} \PYG{n+nb}{int}\PYG{p}{,} \PYG{n}{end}\PYG{p}{:} \PYG{n+nb}{int}\PYG{p}{,} \PYG{n}{content}\PYG{p}{:} \PYG{n+nb}{str}\PYG{p}{)} \PYG{o}{\PYGZhy{}\PYGZgt{}} \PYG{k+kc}{None}\PYG{p}{:}
    \PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}Edit a file.}

\PYG{l+s+sd}{    It replaces lines `start` through `end` (inclusive) with the given text `content` in the open file. Remember, the file must be open before editing.}

