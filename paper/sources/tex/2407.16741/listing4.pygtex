\begin{Verbatim}[commandchars=\\\{\}]
\PYGZsh{} Instructions
Review the current state of the page and all other information to find the best possible next action to accomplish your goal. Your answer will be interpreted and executed by a program, make sure to follow the formatting instructions.

\PYGZsh{} Goal:
Browse localhost:8000, and tell me the ultimate answer to life. Do not ask me for confirmation at any point.

\PYGZsh{} Action Space

16 different types of actions are available.

noop(wait\PYGZus{}ms: float = 1000)
    Examples:
        noop()

        noop(500)

send\PYGZus{}msg\PYGZus{}to\PYGZus{}user(text: str)
    Examples:
        send\PYGZus{}msg\PYGZus{}to\PYGZus{}user(\PYGZsq{}Based on the results of my search, the city was built in 1751.\PYGZsq{})

scroll(delta\PYGZus{}x: float, delta\PYGZus{}y: float)
    Examples:
        scroll(0, 200)

        scroll(\PYGZhy{}50.2, \PYGZhy{}100.5)

fill(bid: str, value: str)
    Examples:
        fill(\PYGZsq{}237\PYGZsq{}, \PYGZsq{}example value\PYGZsq{})

        fill(\PYGZsq{}45\PYGZsq{}, \PYGZsq{}multi\PYGZhy{}line\PYGZbs{}nexample\PYGZsq{})

        fill(\PYGZsq{}a12\PYGZsq{}, \PYGZsq{}example with \PYGZdq{}quotes\PYGZdq{}\PYGZsq{})

select\PYGZus{}option(bid: str, options: str | list[str])
    Examples:
        select\PYGZus{}option(\PYGZsq{}48\PYGZsq{}, \PYGZsq{}blue\PYGZsq{})

        select\PYGZus{}option(\PYGZsq{}48\PYGZsq{}, [\PYGZsq{}red\PYGZsq{}, \PYGZsq{}green\PYGZsq{}, \PYGZsq{}blue\PYGZsq{}])

click(bid: str, button: Literal[\PYGZsq{}left\PYGZsq{}, \PYGZsq{}middle\PYGZsq{}, \PYGZsq{}right\PYGZsq{}] = \PYGZsq{}left\PYGZsq{}, modifiers: list[typing.Literal[\PYGZsq{}Alt\PYGZsq{}, \PYGZsq{}Control\PYGZsq{}, \PYGZsq{}Meta\PYGZsq{}, \PYGZsq{}Shift\PYGZsq{}]] = [])
    Examples:
        click(\PYGZsq{}51\PYGZsq{})

        click(\PYGZsq{}b22\PYGZsq{}, button=\PYGZsq{}right\PYGZsq{})

        click(\PYGZsq{}48\PYGZsq{}, button=\PYGZsq{}middle\PYGZsq{}, modifiers=[\PYGZsq{}Shift\PYGZsq{}])

dblclick(bid: str, button: Literal[\PYGZsq{}left\PYGZsq{}, \PYGZsq{}middle\PYGZsq{}, \PYGZsq{}right\PYGZsq{}] = \PYGZsq{}left\PYGZsq{}, modifiers: list[typing.Literal[\PYGZsq{}Alt\PYGZsq{}, \PYGZsq{}Control\PYGZsq{}, \PYGZsq{}Meta\PYGZsq{}, \PYGZsq{}Shift\PYGZsq{}]] = [])
    Examples:
        dblclick(\PYGZsq{}12\PYGZsq{})

        dblclick(\PYGZsq{}ca42\PYGZsq{}, button=\PYGZsq{}right\PYGZsq{})

        dblclick(\PYGZsq{}178\PYGZsq{}, button=\PYGZsq{}middle\PYGZsq{}, modifiers=[\PYGZsq{}Shift\PYGZsq{}])

hover(bid: str)
    Examples:
        hover(\PYGZsq{}b8\PYGZsq{})

