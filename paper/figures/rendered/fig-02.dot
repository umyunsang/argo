digraph ResearchLoop {
  compound=true;
  rankdir=TB;
  bgcolor=white;
  nodesep=0.45;
  ranksep=0.50;

  node [
    shape=box,
    style="filled,solid",
    fillcolor="#FFFFFF",
    color="#222222",
    fontcolor="#111111",
    fontname="Helvetica",
    fontsize=9.5,
    penwidth=1.1,
    margin="0.16,0.10"
  ];

  edge [
    color="#333333",
    fontcolor="#222222",
    fontname="Helvetica",
    fontsize=8.5,
    arrowhead=normal,
    arrowsize=0.75,
    penwidth=1.0
  ];

  subgraph cluster_plan {
    label="Phase 1: Deliberation & Hypothesis Planning";
    fontname="Helvetica-Bold";
    fontsize=10.5;
    color="#666666";
    fillcolor="#F5F5F5";
    style="filled,solid";
    margin=10;

    hypo [label="Hypothesis\n(Formulated Gap & Model Target)", shape=ellipse, penwidth=1.2];
    lit_search [label="Literature search\n(3-Primitive Multi-Source Discovery)"];
    design_comp [label="Design comparison\n(Alternative Scoping • Explicit Falsifiers)"];

    hypo -> lit_search [label="query formulation"];
    lit_search -> design_comp [label="prior evidence"];
  }

  subgraph cluster_exec {
    label="Phase 2: Preregistration & Sandboxed Execution";
    fontname="Helvetica-Bold";
    fontsize=10.5;
    color="#666666";
    fillcolor="#F5F5F5";
    style="filled,solid";
    margin=10;

    prereg [label="Preregistration\n(Immutable Protocol Freeze)", shape=note];
    exec [label="Execution\n(Isolated Sandbox • Call/Token Ceilings)"];
    evidence [label="Evidence\n(Zero-Fit Cryptographic Receipts)"];

    prereg -> exec [label="run authorization"];
    exec -> evidence [label="audit transcripts"];
  }

  subgraph cluster_gate {
    label="Phase 3: Claim Admission & Graph Direction Update";
    fontname="Helvetica-Bold";
    fontsize=10.5;
    color="#666666";
    fillcolor="#F5F5F5";
    style="filled,solid";
    margin=10;

    claim_adm [label="Claim admission\n(Dual Evaluator Audit Gate)", shape=doubleoctagon, penwidth=1.3];
    dir_update [label="Direction update\n(Context Graph State Refresh)", shape=ellipse, penwidth=1.2];

    claim_adm -> dir_update [label="admitted claims"];
  }

  design_comp -> prereg [label="frozen specification"];
  evidence -> claim_adm [label="cryptographic receipts"];

  // Cycle Closing Feedback Edges
  dir_update -> hypo [label="next cycle gap & prior updates", constraint=false, style=bold, penwidth=1.4];
  claim_adm -> hypo [label="refuted hypothesis branch", constraint=false, style=dashed];
}
