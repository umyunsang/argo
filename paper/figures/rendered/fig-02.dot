digraph ResearchLoop {
  compound=true;
  rankdir=TB;
  bgcolor=white;
  nodesep=0.45;
  ranksep=0.45;

  node [
    shape=box,
    style="filled,solid",
    fillcolor="#FFFFFF",
    color="#222222",
    fontcolor="#111111",
    fontname="Helvetica",
    fontsize=9.0,
    penwidth=1.1,
    margin="0.14,0.08"
  ];

  edge [
    color="#333333",
    fontcolor="#222222",
    fontname="Helvetica",
    fontsize=8.0,
    arrowhead=normal,
    arrowsize=0.75,
    penwidth=1.0
  ];

  subgraph cluster_top {
    label="Phase 1: Deliberation & Design Track (Clockwise)";
    fontname="Helvetica-Bold";
    fontsize=9.5;
    color="#666666";
    fillcolor="#F5F5F5";
    style="filled,solid";
    margin=8;

    hypo [label="Hypothesis\n(Literature Gap)", shape=ellipse, penwidth=1.2];
    lit_search [label="Literature search\n(3-Primitive Discovery)"];
    design_comp [label="Design comparison\n(Alternative Scoping)"];
    prereg [label="Preregistration\n(Cryptographic Lock)", shape=note, penwidth=1.2];

    { rank=same; hypo; lit_search; design_comp; prereg; }
    hypo -> lit_search [label="queries"];
    lit_search -> design_comp [label="evidence"];
    design_comp -> prereg [label="protocol"];
  }

  subgraph cluster_bottom {
    label="Phase 2-3: Execution, Audit & Graph Direction Update";
    fontname="Helvetica-Bold";
    fontsize=9.5;
    color="#666666";
    fillcolor="#F5F5F5";
    style="filled,solid";
    margin=8;

    dir_update [label="Direction update\n(Graph State Refresh)", shape=ellipse, penwidth=1.2];
    claim_adm [label="Claim admission\n(Dual Evaluator Gate)", shape=doubleoctagon, penwidth=1.3];
    evidence [label="Evidence\n(Zero-Fit Receipts)"];
    exec [label="Execution\n(Sandboxed Runtime)"];

    { rank=same; dir_update; claim_adm; evidence; exec; }
    // Edges defined from left to right so node order is strictly left to right!
    // Arrows point backwards (dir=back) so data flows from right to left!
    dir_update -> claim_adm [label="admitted", dir=back];
    claim_adm -> evidence [label="receipts", dir=back];
    evidence -> exec [label="transcripts", dir=back];
  }

  // Right edge: Downwards from Preregistration to Execution
  prereg -> exec [label="run authorization", style=bold, penwidth=1.3];

  // Left edge: Upwards from Direction update to Hypothesis (Closes the Loop!)
  dir_update -> hypo [label="next cycle gap", style=bold, penwidth=1.4];
  claim_adm -> hypo [label="refuted branch", style=dashed, constraint=false];
}
