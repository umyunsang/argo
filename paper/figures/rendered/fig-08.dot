digraph EvidenceChain {
  compound=true;
  rankdir=TB;
  bgcolor=white;
  nodesep=0.40;
  ranksep=0.45;

  node [
    shape=box,
    style="filled,solid",
    fillcolor="#FFFFFF",
    color="#222222",
    fontcolor="#111111",
    fontname="Helvetica",
    fontsize=9.5,
    penwidth=1.1,
    margin="0.16,0.10"
  ];

  edge [
    color="#333333",
    fontcolor="#222222",
    fontname="Helvetica",
    fontsize=8.5,
    arrowhead=normal,
    arrowsize=0.75,
    penwidth=1.0
  ];

  subgraph cluster_source_audit {
    label="Level 1: Source & Cryptographic Excerpt Audit";
    fontname="Helvetica-Bold";
    fontsize=10.5;
    color="#666666";
    fillcolor="#F5F5F5";
    style="filled,solid";
    margin=10;

    src_arch [label="Source archive\n(Pinned Tarball URL • SHA-256 Digest)", shape=folder, penwidth=1.2];
    dig_ver [label="Digest verification\n(Bit-for-Bit Un-tar • 130 Archives, 782 Files Checked)"];
    claim_loc [label="Claim locator\n(178 Reviewed Exact Line Spans • Excerpt Hashes)", shape=note, penwidth=1.2];

    src_arch -> dig_ver [label="validates download"];
    dig_ver -> claim_loc [label="extracts physical lines"];
  }

  subgraph cluster_system_audit {
    label="Level 2: Build Environment & Artifact Verification";
    fontname="Helvetica-Bold";
    fontsize=10.5;
    color="#666666";
    fillcolor="#F5F5F5";
    style="filled,solid";
    margin=10;

    loc_gate [label="Locator gate\n(Zero Stale Evidence Enforced on Commit)", shape=doubleoctagon, penwidth=1.3];
    clean_clone [label="Clean clone validation\n(Isolated Sandbox Container Rebuild)"];
    repro_receipt [label="Reproducible build receipt\n(Byte-Identical DOCX/PDF Confirmed)", shape=box, style="filled,bold", penwidth=1.3];

    loc_gate -> clean_clone [label="verifies freshness"];
    clean_clone -> repro_receipt [label="checks byte identity"];
  }

  claim_loc -> loc_gate [label="cryptographic binding", style=bold, penwidth=1.3];
}
