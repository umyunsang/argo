digraph EvidenceChain {
  compound=true;
  rankdir=TB;
  bgcolor=white;
  nodesep=0.45;
  ranksep=0.55;

  node [
    shape=box,
    style="filled,solid",
    fillcolor="#FFFFFF",
    color="#222222",
    fontcolor="#111111",
    fontname="Helvetica",
    fontsize=9.0,
    penwidth=1.1,
    margin="0.14,0.08"
  ];

  edge [
    color="#333333",
    fontcolor="#222222",
    fontname="Helvetica",
    fontsize=8.0,
    arrowhead=normal,
    arrowsize=0.75,
    penwidth=1.0
  ];

  subgraph cluster_level1 {
    label="Level 1: Source & Excerpt Audit";
    fontname="Helvetica-Bold";
    fontsize=10.0;
    color="#777777";
    fillcolor="#F5F5F5";
    style="filled,solid";
    margin=10;

    src_arch [label="Source archive\n(Pinned Tarball • Digest)", shape=folder, penwidth=1.2];
    dig_ver [label="Digest verification\n(130 Archives, 782 Files)"];
    claim_loc [label="Claim locator\n(178 Reviewed Locators)", shape=note, penwidth=1.2];

    { rank=same; src_arch; dig_ver; claim_loc; }
    src_arch -> dig_ver [label="verifies"];
    dig_ver -> claim_loc [label="extracts"];
  }

  subgraph cluster_level2 {
    label="Level 2: Build & Verification Audit";
    fontname="Helvetica-Bold";
    fontsize=10.0;
    color="#666666";
    fillcolor="#F5F5F5";
    style="filled,solid";
    margin=10;

    loc_gate [label="Locator gate\n(Zero Stale Evidence)", shape=doubleoctagon, penwidth=1.3];
    clean_clone [label="Clean clone validation\n(Isolated Container Build)"];
    repro_receipt [label="Reproducible build receipt\n(Byte-Identical Confirmed)", shape=box, style="filled,bold", penwidth=1.3];

    { rank=same; loc_gate; clean_clone; repro_receipt; }
    loc_gate -> clean_clone [label="enforces"];
    clean_clone -> repro_receipt [label="checks"];
  }

  // Left alignment to stack clusters cleanly
  src_arch -> loc_gate [style=invis];
  // Inter-cluster connection
  claim_loc -> loc_gate [label="hash binding", style=bold, penwidth=1.3];
}
