digraph DecisionProtocol {
  compound=true;
  rankdir=TB;
  bgcolor=white;
  nodesep=0.35;
  ranksep=0.45;

  node [
    shape=box,
    style="filled,solid",
    fillcolor="#FFFFFF",
    color="#222222",
    fontcolor="#111111",
    fontname="Helvetica",
    fontsize=9.5,
    penwidth=1.1,
    margin="0.14,0.09"
  ];

  edge [
    color="#333333",
    fontcolor="#222222",
    fontname="Helvetica",
    fontsize=8.5,
    arrowhead=normal,
    arrowsize=0.75,
    penwidth=1.0
  ];

  subgraph cluster_protocol {
    label="6-Field Structured Decision Protocol";
    fontname="Helvetica-Bold";
    fontsize=10.5;
    color="#666666";
    fillcolor="#F5F5F5";
    style="filled,solid";
    margin=10;

    q_node [label="Question\n(Explicit Scientific Dilemma)", shape=box];
    alt_node [label="Alternatives\n(Scoped Competing Paths)", shape=box];
    loc_node [label="Reviewed locators\n(Verified Physical Citations)", shape=box];
    rat_node [label="Rationale\n(Comparative Reasoning)", shape=box];
    dec_node [label="Decision\n(Committed Technical Choice)", shape=box, style="filled,bold", penwidth=1.4];
    fal_node [label="Falsifier\n(Pre-registered Refusal Condition)", shape=box, penwidth=1.3];

    q_node -> alt_node -> loc_node -> rat_node -> dec_node;
    dec_node -> fal_node [label="mandatory guard"];
  }

  subgraph cluster_identity {
    label="Comparison identity check (Three-Object Gate)";
    fontname="Helvetica-Bold";
    fontsize=10.5;
    color="#666666";
    fillcolor="#F5F5F5";
    style="filled,dashed";
    margin=10;

    arm_base [label="Object A: Baseline Arm\n(Frozen Reference Base)", fillcolor="#FFFFFF"];
    arm_cand [label="Object B: Candidate Arm\n(Isolated Single Intervention)", fillcolor="#FFFFFF"];
    arm_ctrl [label="Object C: Matched Control\n(Same Seed • Equal Compute Floor)", fillcolor="#FFFFFF"];
    
    comp_gate [label="Comparison identity check\n(Verifier Gate: Model, Compute, Seed)", shape=doubleoctagon, penwidth=1.3];

    arm_base -> comp_gate;
    arm_cand -> comp_gate;
    arm_ctrl -> comp_gate;
  }

  dec_node -> comp_gate [label="execution proposal"];
  comp_gate -> fal_node [constraint=false, label="triggers reversal if violated", style=dashed];
}
