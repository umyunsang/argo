digraph G {
  rankdir=LR;
  bgcolor=white;
  node [shape=box, style=solid, color=black, fontcolor=black, fontname="Helvetica", fontsize=20, penwidth=1.6, margin="0.30,0.18"];
  edge [color=black, fontcolor=black, arrowhead=normal, penwidth=1.0];
  splines=ortho;
  nodesep=0.70; ranksep=0.85;
  "Question" [label="Question"];
  "Alternatives" [label="Alternatives"];
  "Reviewed locators" [label="Reviewed locators"];
  "Rationale" [label="Rationale"];
  "Decision" [label="Decision"];
  "Falsifier" [label="Falsifier"];
  "Comparison identity check" [label="Comparison identity check"];
  "Question" -> "Alternatives";
  "Alternatives" -> "Reviewed locators";
  "Reviewed locators" -> "Rationale";
  "Rationale" -> "Decision";
  "Decision" -> "Falsifier";
  "Decision" -> "Comparison identity check";
}
