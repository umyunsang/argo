digraph HarnessLineage {
  compound=true;
  rankdir=TB;
  bgcolor=white;
  nodesep=0.40;
  ranksep=0.45;

  node [
    shape=box,
    style="filled,solid",
    fillcolor="#FFFFFF",
    color="#222222",
    fontcolor="#111111",
    fontname="Helvetica",
    fontsize=9.5,
    penwidth=1.1,
    margin="0.16,0.10"
  ];

  edge [
    color="#333333",
    fontcolor="#222222",
    fontname="Helvetica",
    fontsize=8.5,
    arrowhead=normal,
    arrowsize=0.75,
    penwidth=1.0
  ];

  subgraph cluster_stages {
    label="Three-Stage Harness Lineage Evolution";
    fontname="Helvetica-Bold";
    fontsize=10.5;
    color="#666666";
    fillcolor="#F5F5F5";
    style="filled,solid";
    margin=12;

    stage1 [
      label="Minimal harness\n(Stage 1: Pi Paradigm)\n4 Primitive Tools • Short System Prompt\nGrey Literature • No Peer Review",
      shape=box
    ];

    stage2 [
      label="Expressive harness\n(Stage 2: Prime Agent Paradigm)\nPersistent IPython REPL • Dynamic State\nPublic Report • No Confidence Intervals",
      shape=box
    ];

    stage3 [
      label="Accountable research harness\n(Stage 3: ARGO - This Study)\nTyped Decision Ledger • Context Graph\nDual Evaluator • 13 Enforced Form Gates",
      shape=box,
      style="filled,bold",
      penwidth=1.4
    ];

    stage1 -> stage2 [label="adds expressive medium", penwidth=1.1];
    stage2 -> stage3 [label="adds accountability & audit", penwidth=1.4];
  }

  subgraph cluster_axes {
    label="Design Evaluation Dimensions";
    fontname="Helvetica-Bold";
    fontsize=10.0;
    color="#777777";
    fillcolor="#F5F5F5";
    style="filled,dashed";
    margin=8;

    cap_axis [label="Capability axis\n(Expressive Medium & Tool Reach)", shape=ellipse];
    acc_axis [label="Accountability axis\n(Falsification & Provenance Binding)", shape=ellipse];
  }

  cap_axis -> stage2 [style=dashed, label="drives Stage 2"];
  acc_axis -> stage3 [style=bold, label="drives Stage 3"];

  this_study [
    label="This study\n(Methodological Roadmap for Autonomous R&D)",
    shape=doubleoctagon,
    penwidth=1.3
  ];

  stage3 -> this_study [label="empirically evaluated"];
}
