digraph G {
  rankdir=TB;
  bgcolor=white;
  node [shape=box, style=solid, color=black, fontcolor=black, fontname="Helvetica", fontsize=20, penwidth=1.6, margin="0.30,0.18"];
  edge [color=black, fontcolor=black, arrowhead=normal, penwidth=1.0];
  splines=ortho;
  nodesep=0.70; ranksep=0.85;
  "Minimal harness" [label="Minimal harness"];
  "Expressive harness" [label="Expressive harness"];
  "Accountable research harness" [label="Accountable research harness"];
  "Capability axis" [label="Capability axis"];
  "Accountability axis" [label="Accountability axis"];
  "This study" [label="This study"];
  "Minimal harness" -> "Expressive harness";
  "Expressive harness" -> "Accountable research harness";
  "Capability axis" -> "Expressive harness";
  "Accountability axis" -> "Accountable research harness";
  "Accountable research harness" -> "This study";
}
