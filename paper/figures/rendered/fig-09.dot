digraph G {
  rankdir=TB;
  bgcolor=white;
  node [shape=box, style=solid, color=black, fontcolor=black, fontname="Helvetica", fontsize=20, penwidth=1.6, margin="0.30,0.18"];
  edge [color=black, fontcolor=black, arrowhead=normal, penwidth=1.0];
  splines=ortho;
  nodesep=0.70; ranksep=0.85;
  "Autonomy axis" [label="Autonomy axis"];
  "Evidence binding axis" [label="Evidence binding axis"];
  "Prior agent benchmarks" [label="Prior agent benchmarks"];
  "Prior autonomous research systems" [label="Prior autonomous research systems"];
  "This study" [label="This study"];
  "Autonomy axis" -> "This study";
  "Evidence binding axis" -> "This study";
  "Prior agent benchmarks" -> "Autonomy axis";
  "Prior autonomous research systems" -> "Evidence binding axis";
}
