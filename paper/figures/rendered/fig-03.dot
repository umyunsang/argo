digraph G {
  rankdir=LR;
  bgcolor=white;
  node [shape=box, style=solid, color=black, fontcolor=black, fontname="Helvetica", fontsize=20, penwidth=1.6, margin="0.30,0.18"];
  edge [color=black, fontcolor=black, arrowhead=normal, penwidth=1.0];
  splines=ortho;
  nodesep=0.70; ranksep=0.85;
  "Hypothesis node" [label="Hypothesis node"];
  "Decision node" [label="Decision node"];
  "Experiment node" [label="Experiment node"];
  "Result node" [label="Result node"];
  "Claim node" [label="Claim node"];
  "Source node" [label="Source node"];
  "Figure node" [label="Figure node"];
  "Hypothesis node" -> "Decision node";
  "Decision node" -> "Experiment node";
  "Experiment node" -> "Result node";
  "Result node" -> "Claim node";
  "Source node" -> "Decision node";
  "Figure node" -> "Claim node";
  "Result node" -> "Hypothesis node";
}
