digraph ContextGraphSchema {
  compound=true;
  rankdir=TB;
  bgcolor=white;
  nodesep=0.40;
  ranksep=0.50;

  node [
    shape=box,
    style="filled,solid",
    fillcolor="#FFFFFF",
    color="#222222",
    fontcolor="#111111",
    fontname="Helvetica",
    fontsize=9.5,
    penwidth=1.1,
    margin="0.14,0.10"
  ];

  edge [
    color="#333333",
    fontcolor="#222222",
    fontname="Helvetica",
    fontsize=8.5,
    arrowhead=normal,
    arrowsize=0.75,
    penwidth=1.0
  ];

  subgraph cluster_conceptual {
    label="Conceptual & Planning Layer";
    fontname="Helvetica-Bold";
    fontsize=10.0;
    color="#666666";
    fillcolor="#F5F5F5";
    style="filled,solid";
    margin=10;

    hypo_node [
      label="Hypothesis node\n(Structured Scientific Target)",
      shape=ellipse,
      penwidth=1.2
    ];

    dec_node [
      label="Decision node\n(6 Fields: Question, Rationale, Falsifier)",
      shape=box,
      penwidth=1.2
    ];

    source_node [
      label="Source node\n(External Literature Archive & Digest)",
      shape=folder,
      fillcolor="#FFFFFF"
    ];
  }

  subgraph cluster_empirical {
    label="Empirical & Execution Layer";
    fontname="Helvetica-Bold";
    fontsize=10.0;
    color="#666666";
    fillcolor="#F5F5F5";
    style="filled,solid";
    margin=10;

    exp_node [
      label="Experiment node\n(Sandboxed Task & Pre-allocated Budget)",
      shape=box
    ];

    res_node [
      label="Result node\n(Statistical Metrics & Variance Components)",
      shape=box
    ];
  }

  subgraph cluster_dissemination {
    label="Evidence & Dissemination Layer";
    fontname="Helvetica-Bold";
    fontsize=10.0;
    color="#666666";
    fillcolor="#F5F5F5";
    style="filled,solid";
    margin=10;

    claim_node [
      label="Claim node\n(Validated Scoped Manuscript Assertion)",
      shape=ellipse,
      penwidth=1.2
    ];

    fig_node [
      label="Figure node\n(Diagram Spec, Route & OCR Verification)",
      shape=note,
      fillcolor="#FFFFFF"
    ];
  }

  hypo_node -> dec_node [label="formulates choice"];
  source_node -> dec_node [label="cites prior work"];
  dec_node -> exp_node [label="executes run"];
  exp_node -> res_node [label="produces measurement"];
  res_node -> claim_node [label="supports assertion"];
  fig_node -> claim_node [label="visual evidence"];

  // Feedback edge: Result refutes or refines Hypothesis
  res_node -> hypo_node [label="refutes / refines", constraint=false, style=bold, penwidth=1.3];
}
