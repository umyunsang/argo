digraph EvaluationPipeline {
  compound=true;
  rankdir=TB;
  bgcolor=white;
  nodesep=0.40;
  ranksep=0.45;

  node [
    shape=box,
    style="filled,solid",
    fillcolor="#FFFFFF",
    color="#222222",
    fontcolor="#111111",
    fontname="Helvetica",
    fontsize=9.5,
    penwidth=1.1,
    margin="0.16,0.10"
  ];

  edge [
    color="#333333",
    fontcolor="#222222",
    fontname="Helvetica",
    fontsize=8.5,
    arrowhead=normal,
    arrowsize=0.75,
    penwidth=1.0
  ];

  subgraph cluster_execution_tier {
    label="Tier 1-2: Execution & Scoring Tier";
    fontname="Helvetica-Bold";
    fontsize=10.5;
    color="#666666";
    fillcolor="#F5F5F5";
    style="filled,solid";
    margin=10;

    task_rel [label="Withheld task release\n(Unseen Targets K5/K6 • Isolated Benchmark)", shape=box, penwidth=1.2];
    sand_ep [label="Sandbox episode\n(Isolated Container • Call/Token Ceilings)"];
    score_lay [label="Deterministic scoring layer\n(Canary Probes • Structural Gap Verification)", shape=component];

    task_rel -> sand_ep [label="releases target"];
    sand_ep -> score_lay [label="execution transcripts"];
  }

  subgraph cluster_gate_tier {
    label="Tier 3-4: Gating & Calibration Tier";
    fontname="Helvetica-Bold";
    fontsize=10.5;
    color="#666666";
    fillcolor="#F5F5F5";
    style="filled,solid";
    margin=10;

    adm_gate [label="Admission gate\n(5 Refusal Checks: Unexecuted, Fired, Unmeasured, Exceeded)", shape=doubleoctagon, penwidth=1.3];
    judge_mod [label="Judge model\n(Dual Heterogeneous Judges: Qwen3.6-27B & GLM-5.3)"];
    cal_gate [label="Calibration gate\n(UCB Error Bound on Anchor • Selective Evaluator)", shape=doubleoctagon, penwidth=1.3];

    adm_gate -> judge_mod [label="admitted episodes"];
    judge_mod -> cal_gate [label="confidence scores"];
  }

  verdict_node [
    label="Verdict\n(Admitted / Withheld Score)",
    shape=ellipse,
    penwidth=1.3
  ];

  score_lay -> adm_gate [label="structural audit"];
  cal_gate -> verdict_node [label="certified verdict"];
  adm_gate -> verdict_node [label="refusal (inadmissible)", style=dashed, constraint=false];
}
