digraph SystemArchitecture {
  compound=true;
  rankdir=TB;
  bgcolor=white;
  nodesep=0.40;
  ranksep=0.45;

  node [
    shape=box,
    style="filled,solid",
    fillcolor="#FFFFFF",
    color="#222222",
    fontcolor="#111111",
    fontname="Helvetica",
    fontsize=9.5,
    penwidth=1.1,
    margin="0.14,0.09"
  ];

  edge [
    color="#333333",
    fontcolor="#222222",
    fontname="Helvetica",
    fontsize=8.5,
    arrowhead=normal,
    arrowsize=0.75,
    penwidth=1.0
  ];

  subgraph cluster_host {
    label="Host & Control Plane (Autonomous Orchestration)";
    fontname="Helvetica-Bold";
    fontsize=10.5;
    color="#666666";
    fillcolor="#F5F5F5";
    style="filled,solid";
    penwidth=1.0;
    margin=10;

    root_agent [
      label="Root agent\n(Hypothesis Formulation • Model Routing • Task Decomposition)",
      shape=component,
      penwidth=1.2
    ];

    context_graph [
      label="Context graph\n(Typed State DAG: 410 Nodes, 737 Edges • Hash Pinned)",
      shape=folder,
      penwidth=1.2
    ];
  }

  subgraph cluster_middle {
    style=invis;
    
    subgraph cluster_retrieval {
      label="Literature Discovery Plane";
      fontname="Helvetica-Bold";
      fontsize=10.0;
      color="#777777";
      fillcolor="#F5F5F5";
      style="filled,dashed";
      margin=8;

      lit_retrieval [
        label="Literature retrieval\n(Multi-Primitive: Keyword • Embedding • Citation Graph)",
        fillcolor="#FFFFFF"
      ];

      evidence_proto [
        label="Evidence protocol\n(Physical Line Locators • SHA-256 Digest Extraction)",
        fillcolor="#FFFFFF"
      ];
    }

    subgraph cluster_execution {
      label="Execution & Protocol Plane";
      fontname="Helvetica-Bold";
      fontsize=10.0;
      color="#777777";
      fillcolor="#F5F5F5";
      style="filled,dashed";
      margin=8;

      dec_proto [
        label="Decision protocol\n(6-Field Records: Question, Rationale, Falsifier)",
        fillcolor="#FFFFFF"
      ];

      sandbox_exec [
        label="Sandbox execution\n(Isolated Runtime Container • Call/Token Ceilings)",
        fillcolor="#FFFFFF"
      ];
    }
  }

  subgraph cluster_synthesis {
    label="Deterministic Verification & Synthesis Plane";
    fontname="Helvetica-Bold";
    fontsize=10.5;
    color="#666666";
    fillcolor="#F5F5F5";
    style="filled,solid";
    penwidth=1.0;
    margin=10;

    validator [
      label="Deterministic validator\n(13 Enforced Form & Security Gates • Zero Public Leaks)",
      shape=doubleoctagon,
      penwidth=1.3,
      fillcolor="#FFFFFF"
    ];

    synthesis [
      label="Manuscript synthesis\n(Quarto/Typst Engine • Receipt-Asserted Tables • A4)",
      fillcolor="#FFFFFF"
    ];
  }

  root_agent -> lit_retrieval [label="search queries"];
  lit_retrieval -> evidence_proto [label="candidate texts"];
  root_agent -> dec_proto [label="formulates proposal"];
  context_graph -> dec_proto [label="active gaps & priors"];
  dec_proto -> sandbox_exec [label="preregistered task"];
  sandbox_exec -> validator [label="execution transcripts"];
  evidence_proto -> validator [label="signed receipts"];
  validator -> synthesis [label="verified evidence bytes"];

  evidence_proto -> context_graph [constraint=false, label="citation nodes", style=dashed];
  validator -> context_graph [constraint=false, label="DAG hash update", style=bold, penwidth=1.4];
  synthesis -> root_agent [constraint=false, label="verified manuscript", style=dotted];
}
