digraph G {
  rankdir=LR;
  bgcolor=white;
  node [shape=box, style=solid, color=black, fontcolor=black, fontname="Helvetica", fontsize=20, penwidth=1.6, margin="0.30,0.18"];
  edge [color=black, fontcolor=black, arrowhead=normal, penwidth=1.0];
  splines=ortho;
  nodesep=0.70; ranksep=0.85;
  "Artifact" [label="Artifact"];
  "Cue retrieval" [label="Cue retrieval"];
  "Candidate span" [label="Candidate span"];
  "Span based verdict" [label="Span based verdict"];
  "Whole artifact verdict" [label="Whole artifact verdict"];
  "Twenty percent subsample" [label="Twenty percent subsample"];
  "Drift check" [label="Drift check"];
  "Artifact" -> "Cue retrieval";
  "Cue retrieval" -> "Candidate span";
  "Candidate span" -> "Span based verdict";
  "Artifact" -> "Whole artifact verdict";
  "Span based verdict" -> "Twenty percent subsample";
  "Whole artifact verdict" -> "Twenty percent subsample";
  "Twenty percent subsample" -> "Drift check";
}
