digraph ScoringComparison {
  compound=true;
  rankdir=TB;
  bgcolor=white;
  nodesep=0.40;
  ranksep=0.45;

  node [
    shape=box,
    style="filled,solid",
    fillcolor="#FFFFFF",
    color="#222222",
    fontcolor="#111111",
    fontname="Helvetica",
    fontsize=9.5,
    penwidth=1.1,
    margin="0.16,0.10"
  ];

  edge [
    color="#333333",
    fontcolor="#222222",
    fontname="Helvetica",
    fontsize=8.5,
    arrowhead=normal,
    arrowsize=0.75,
    penwidth=1.0
  ];

  art_in [
    label="Artifact\n(Candidate Research Output)",
    shape=note,
    penwidth=1.2
  ];

  subgraph cluster_pathways {
    style=invis;

    subgraph cluster_flawed {
      label="Flawed Pathway: Cue-Based Two-Stage Filter (38.9% False Negatives)";
      fontname="Helvetica-Bold";
      fontsize=10.0;
      color="#777777";
      fillcolor="#F5F5F5";
      style="filled,dashed";
      margin=10;

      cue_ret [label="Cue retrieval\n(Heuristic Keyword Filter)"];
      cand_span [label="Candidate span\n(Truncated Passages)"];
      span_verdict [label="Span based verdict\n(Biased Coverage: 0.542)", shape=box, margin="0.20,0.10"];

      cue_ret -> cand_span -> span_verdict;
    }

    subgraph cluster_repaired {
      label="Repaired Pathway: Whole-Artifact Context Evaluation";
      fontname="Helvetica-Bold";
      fontsize=10.0;
      color="#666666";
      fillcolor="#F5F5F5";
      style="filled,solid";
      margin=10;

      full_verdict [label="Whole artifact verdict\n(True Coverage: 0.729 • +0.188 Shift, 2.3x MDE)", shape=box, style="filled,bold", margin="0.22,0.12", penwidth=1.3];
    }
  }

  subgraph cluster_monitor {
    label="Continuous Drift Monitoring Plane";
    fontname="Helvetica-Bold";
    fontsize=10.0;
    color="#777777";
    fillcolor="#F5F5F5";
    style="filled,dotted";
    margin=10;

    subsample [label="Twenty percent subsample\n(Live Audit Fraction)"];
    drift_chk [label="Drift check\n(Monitors Span vs Full Disparity)", shape=doubleoctagon, penwidth=1.3];

    subsample -> drift_chk;
  }

  art_in -> cue_ret [label="filtered ingestion"];
  art_in -> full_verdict [label="direct full ingestion", style=bold, penwidth=1.3];
  
  span_verdict -> subsample [style=dotted, label="sample audit"];
  full_verdict -> subsample [style=dotted, label="sample audit"];
}
