digraph FactorialDesign {
  compound=true;
  rankdir=TB;
  bgcolor=white;
  nodesep=0.40;
  ranksep=0.45;

  node [
    shape=box,
    style="filled,solid",
    fillcolor="#FFFFFF",
    color="#222222",
    fontcolor="#111111",
    fontname="Helvetica",
    fontsize=9.5,
    penwidth=1.1,
    margin="0.14,0.10"
  ];

  edge [
    color="#333333",
    fontcolor="#222222",
    fontname="Helvetica",
    fontsize=8.5,
    arrowhead=normal,
    arrowsize=0.75,
    penwidth=1.0
  ];

  subgraph cluster_cells {
    label="2x2 Factorial Matrix (State Partitioning x Dynamic Retrieval)";
    fontname="Helvetica-Bold";
    fontsize=10.5;
    color="#666666";
    fillcolor="#F5F5F5";
    style="filled,solid";
    margin=12;

    subgraph cluster_row1 {
      label="Static Context (No Dynamic Search)";
      style="dashed";
      color="#888888";
      margin=8;

      c00 [label="C00 baseline\nUnified State • Static Context\n($0.095/ep • 3.3 calls)"];
      c10 [label="C10 tools only\nPartitioned State • Static Context\n($0.114/ep • 5.0 calls)"];
    }

    subgraph cluster_row2 {
      label="Dynamic Context (Active Literature Discovery)";
      style="dashed";
      color="#888888";
      margin=8;

      c01 [label="C01 context only\nUnified State • Dynamic Search\n($0.165/ep • 8.3 calls)"];
      c11 [label="C11 full\nPartitioned State • Dynamic Search\n($0.256/ep • 11.7 calls)"];
    }
  }

  budget_match [
    label="Budget matching\n(Strict Token Ceiling: 16 Calls • Equal Grounding)",
    shape=box,
    style="filled,bold",
    margin="0.22,0.12",
    penwidth=1.3
  ];

  pilot_block [
    label="Pilot block 16 episodes\n(8 Paired Runs across K5 & K6 Withheld Tasks)",
    shape=folder,
    penwidth=1.3
  ];

  c00 -> budget_match;
  c01 -> budget_match;
  c10 -> budget_match;
  c11 -> budget_match;

  budget_match -> pilot_block [label="enforces equal compute floor"];
}
