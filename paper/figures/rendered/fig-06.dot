digraph G {
  rankdir=TB;
  bgcolor=white;
  node [shape=box, style=solid, color=black, fontcolor=black, fontname="Helvetica", fontsize=20, penwidth=1.6, margin="0.30,0.18"];
  edge [color=black, fontcolor=black, arrowhead=normal, penwidth=1.0];
  splines=ortho;
  nodesep=0.70; ranksep=0.85;
  "C00 baseline" [label="C00 baseline"];
  "C01 context only" [label="C01 context only"];
  "C10 tools only" [label="C10 tools only"];
  "C11 full" [label="C11 full"];
  "Budget matching" [label="Budget matching"];
  "Pilot block 16 episodes" [label="Pilot block 16 episodes"];
  "C00 baseline" -> "Budget matching";
  "C01 context only" -> "Budget matching";
  "C10 tools only" -> "Budget matching";
  "C11 full" -> "Budget matching";
  "Budget matching" -> "Pilot block 16 episodes";
}
