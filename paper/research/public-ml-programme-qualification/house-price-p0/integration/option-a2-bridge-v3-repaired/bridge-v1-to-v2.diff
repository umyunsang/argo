+def _terminate_and_reap(process: subprocess.Popen[bytes]) -> None:
+    try:
+        alive = process.poll() is None
+    except Exception:
+        alive = True
+    if alive:
+        try:
+            os.killpg(process.pid, signal.SIGKILL)
