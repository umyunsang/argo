@dataclass(frozen=True)
class RunControllerConfig:
    python_executable: str
    interpreter_identity: InterpreterIdentity
    process_exec_path: str
    process_exec_identity: PathIdentity
    node_executable: str
    node_identity: PathIdentity
    frontend_path: str
    frontend_identity: PathIdentity
    deployment_path: str
    deployment_identity: PathIdentity
    artifact_root: str
    artifact_root_identity: PathIdentity
    temporary_dir: str
    temporary_dir_identity: PathIdentity
    session_dir: str
    session_dir_identity: PathIdentity
    profile_dir: str
    profile_dir_identity: PathIdentity
    child_environment: Mapping[str, str]
    caps: RunControllerCaps
    campaign_started_monotonic_ns: int
    synthetic_test_context: bool

    @classmethod
    def from_dict(cls, value: Mapping[str, object]) -> "RunControllerConfig":
        _require_keys(value, {item.name for item in field_list(cls)}, "config")
        environment_value = value["child_environment"]
        if not isinstance(environment_value, dict):
            raise ValueError("child_environment must be an object")
        environment: dict[str, str] = {}
        for key, item in environment_value.items():
            if not isinstance(key, str) or not isinstance(item, str):
                raise ValueError("child_environment must contain strings")
            environment[key] = item
        return cls(
            python_executable=_string(value["python_executable"], "python_executable"),
            interpreter_identity=InterpreterIdentity.from_dict(_mapping(value["interpreter_identity"], "interpreter_identity")),
            process_exec_path=_string(value["process_exec_path"], "process_exec_path"),
            process_exec_identity=PathIdentity.from_dict(_mapping(value["process_exec_identity"], "process_exec_identity")),
            node_executable=_string(value["node_executable"], "node_executable"),
            node_identity=PathIdentity.from_dict(_mapping(value["node_identity"], "node_identity")),
            frontend_path=_string(value["frontend_path"], "frontend_path"),
            frontend_identity=PathIdentity.from_dict(_mapping(value["frontend_identity"], "frontend_identity")),
            deployment_path=_string(value["deployment_path"], "deployment_path"),
            deployment_identity=PathIdentity.from_dict(_mapping(value["deployment_identity"], "deployment_identity")),
            artifact_root=_string(value["artifact_root"], "artifact_root"),
            artifact_root_identity=PathIdentity.from_dict(_mapping(value["artifact_root_identity"], "artifact_root_identity")),
            temporary_dir=_string(value["temporary_dir"], "temporary_dir"),
            temporary_dir_identity=PathIdentity.from_dict(_mapping(value["temporary_dir_identity"], "temporary_dir_identity")),
            session_dir=_string(value["session_dir"], "session_dir"),
            session_dir_identity=PathIdentity.from_dict(_mapping(value["session_dir_identity"], "session_dir_identity")),
            profile_dir=_string(value["profile_dir"], "profile_dir"),
            profile_dir_identity=PathIdentity.from_dict(_mapping(value["profile_dir_identity"], "profile_dir_identity")),
            child_environment=environment,
            caps=RunControllerCaps.from_dict(_mapping(value["caps"], "caps")),
            campaign_started_monotonic_ns=_integer(value["campaign_started_monotonic_ns"], "campaign_started_monotonic_ns"),
            synthetic_test_context=_boolean(value["synthetic_test_context"], "synthetic_test_context"),
        )


