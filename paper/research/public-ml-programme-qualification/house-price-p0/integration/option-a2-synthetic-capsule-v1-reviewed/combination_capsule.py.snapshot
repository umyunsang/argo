"""Materialize the exact test-only A2-Faux-C1 capsule without importing its code.

This is deliberately separate from production namespace materialization. Exact
member hashes come from the root review manifest, never from model output.
"""
from __future__ import annotations
from pathlib import Path

from experiments.argo_workflow_followup.public_ml_apparatus.house_price_runtime.deployment_assets import (
    NamespaceMember, PACKAGE_PATHS, _new_private_path, _sync_directory, _write_new,
)
from experiments.argo_workflow_followup.public_ml_apparatus.house_price_runtime.grading import FileBinding, read_bound
from experiments.argo_workflow_followup.public_ml_apparatus.house_price_runtime.source_closure import ClosureLimits, SourceTree, capture_tree

EXACT_MEMBERS = frozenset(('experiments/argo_workflow_followup/public_ml_apparatus/house_price_runtime/bridge.py', 'experiments/argo_workflow_followup/public_ml_apparatus/house_price_runtime/campaign_usage.py', 'experiments/argo_workflow_followup/public_ml_apparatus/house_price_runtime/combination_acceptance.py', 'experiments/argo_workflow_followup/public_ml_apparatus/house_price_runtime/combination_driver.py', 'experiments/argo_workflow_followup/public_ml_apparatus/house_price_runtime/combination_fixture.py', 'experiments/argo_workflow_followup/public_ml_apparatus/house_price_runtime/container_entry.py', 'experiments/argo_workflow_followup/public_ml_apparatus/house_price_runtime/container_runner.py', 'experiments/argo_workflow_followup/public_ml_apparatus/house_price_runtime/controller_deployment.py', 'experiments/argo_workflow_followup/public_ml_apparatus/house_price_runtime/controller_process.py', 'experiments/argo_workflow_followup/public_ml_apparatus/house_price_runtime/deployment_assets.py', 'experiments/argo_workflow_followup/public_ml_apparatus/house_price_runtime/grading.py', 'experiments/argo_workflow_followup/public_ml_apparatus/house_price_runtime/intent.py', 'experiments/argo_workflow_followup/public_ml_apparatus/house_price_runtime/orx_text.py', 'experiments/argo_workflow_followup/public_ml_apparatus/house_price_runtime/phase_completion.py', 'experiments/argo_workflow_followup/public_ml_apparatus/house_price_runtime/phase_driver.py', 'experiments/argo_workflow_followup/public_ml_apparatus/house_price_runtime/phase_gate.py', 'experiments/argo_workflow_followup/public_ml_apparatus/house_price_runtime/process_exec.py', 'experiments/argo_workflow_followup/public_ml_apparatus/house_price_runtime/receipt_store.py', 'experiments/argo_workflow_followup/public_ml_apparatus/house_price_runtime/run_entry.py', 'experiments/argo_workflow_followup/public_ml_apparatus/house_price_runtime/source_closure.py', 'experiments/argo_workflow_followup/public_ml_apparatus/house_price_runtime/staging.py', 'experiments/argo_workflow_followup/public_ml_apparatus/house_price_runtime/test_bridge.py', 'experiments/argo_workflow_followup/public_ml_apparatus/house_price_runtime/trusted_io.py', 'experiments/argo_workflow_followup/public_ml_apparatus/house_price_runtime/usage_observer.py', 'experiments/argo_workflow_followup/public_ml_apparatus/house_price_scorer.py'))
LIMITS = ClosureLimits(160,8388608,1048576,8,4096)


class SyntheticCapsuleError(ValueError):
    def __init__(self):super().__init__("SYNTHETIC_CAPSULE_INVALID")


def materialize_synthetic_capsule(destination: Path, members: tuple[NamespaceMember,...]) -> SourceTree:
    try:
        _new_private_path(destination)
        if type(members) is not tuple or len(members)!=len(EXACT_MEMBERS):
            raise SyntheticCapsuleError()
        names=set()
        for member in members:
            if (not isinstance(member,NamespaceMember) or type(member.relative_path) is not str or
                    member.relative_path not in EXACT_MEMBERS or member.relative_path in names):
                raise SyntheticCapsuleError()
            names.add(member.relative_path)
        if names!=EXACT_MEMBERS:raise SyntheticCapsuleError()
        total=0
        sources=[]
        for member in sorted(members,key=lambda item:item.relative_path):
            data=read_bound(member.source,LIMITS.max_file_bytes)
            total+=len(data)
            if total>LIMITS.max_total_bytes:raise SyntheticCapsuleError()
            sources.append((member,data))
        destination.mkdir(mode=0o700)
        for relative in PACKAGE_PATHS:
            directory=destination/relative
            directory.mkdir(mode=0o700)
            _write_new(directory/"__init__.py",b"",0o600)
        for member,data in sources:
            path=destination/member.relative_path
            _write_new(path,data,0o600)
            info=path.lstat()
            copied=FileBinding(path,member.source.sha256,member.source.bytes,info.st_mtime_ns)
            if read_bound(copied,LIMITS.max_file_bytes)!=data:
                raise SyntheticCapsuleError()
        for relative in reversed(PACKAGE_PATHS):_sync_directory(destination/relative)
        _sync_directory(destination);_sync_directory(destination.parent)
        tree=capture_tree(destination,LIMITS)
        if (tree.file_count!=len(EXACT_MEMBERS)+4 or tree.directory_count!=4 or
                tree.symlink_count!=0 or tree.total_file_bytes!=total):
            raise SyntheticCapsuleError()
        return tree
    except Exception:
        raise SyntheticCapsuleError() from None
