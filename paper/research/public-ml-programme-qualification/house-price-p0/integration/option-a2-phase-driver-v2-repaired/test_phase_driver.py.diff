+class PhaseDriverRepairTests(unittest.TestCase):
+    def make_case(self) -> PhaseDriverTests:
+        case = PhaseDriverTests("test_startup_guard_is_callable_and_same_observer_finalizes_clean_receipts")
+        case.setUp()
+        return case
+
+    def test_replaced_session_directory_identity_never_returns_current_or_clean(self) -> None:
+        case = self.make_case()
+        try:
+            original_inode = case.session.stat().st_ino
+            waiting = case.observation("WAITING_FIRST_USAGE", None, False, None, None, with_session=False)
+            within = case.observation("WITHIN_BUDGET", None, True, 100, 100, with_session=True)
+            session_file = case.session / f"{within.session_id}.jsonl"
+            session_bytes = session_file.read_bytes()
+
+            class SwapObserver:
+                index = 0
+
+                def observe(self):
+                    self.index += 1
+                    if self.index == 1:
+                        return waiting
+                    old = case.artifact / "session-old"
+                    case.session.rename(old)
+                    case.session.mkdir(mode=0o700)
+                    (case.session / session_file.name).write_bytes(session_bytes)
+                    return within
+
+            result = case.execute_patched(SwapObserver(), case.process_receipt())
+            self.assertNotEqual(case.session.stat().st_ino, original_inode)
+            self.assertIsNone(result.current_session)
+            self.assertFalse(result.clean_process)
+        finally:
+            case.tearDown()
+
+    def test_malformed_or_foreign_process_receipt_is_never_clean(self) -> None:
+        case = self.make_case()
+        try:
+            within = case.observation("WITHIN_BUDGET", None, True, 100, 100, with_session=True)
+            current = phase_driver_module._current_session(case.process_config, case.gate_inputs.session_directory, within)
+            receipt = case.process_receipt()
+            malformed_handle = replace(
+                receipt.handle,
+                frontend_path=str(case.root / "foreign-frontend"),
+                process_exec_path=str(case.root / "foreign-process-exec"),
+            )
+            malformed = replace(receipt, handle=malformed_handle, resources=None, cleanup=None)
+            self.assertFalse(
+                phase_driver_module._clean_process(
+                    malformed,
+                    case.process_config,
+                    within,
+                    current,
+                )
+            )
+        finally:
+            case.tearDown()
+
+    def test_incomplete_frontend_deployment_is_rejected_before_admission(self) -> None:
+        case = self.make_case()
+        try:
+            process = replace(
+                case.process_config,
+                process_exec_identity=replace(
+                    case.process_config.process_exec_identity,
+                    sha256=phase_driver_module.PROCESS_EXEC_SHA256,
+                ),
+                frontend_identity=replace(
+                    case.process_config.frontend_identity,
+                    sha256=phase_driver_module.FRONTEND_SHA256,
+                ),
+            )
+
+            def directory_record(path, identity):
+                return {"path": path, "device": str(identity.device), "inode": str(identity.inode)}
+
+            deployment = {
+                "schema_version": "argo-house-price-a2-controller-main-deployment/v1",
+                "status": "TRUSTED_FIXED_DEPLOYMENT",
+                "assets": {
+                    "controller_main": {"path": process.frontend_path, "sha256": phase_driver_module.FRONTEND_SHA256},
+                    "node_executable": {"path": process.node_executable, "sha256": process.node_identity.sha256},
+                    "prime_entry": {
+                        "path": str(case.root / "outside-prime"),
+                        "sha256": "f" * 64,
+                        "bytes": 1,
+                        "mtime_ns_max": "1",
+                    },
+                },
+                "directories": {
+                    "artifact_root": directory_record(process.artifact_root, process.artifact_root_identity),
+                    "profile": directory_record(process.profile_dir, process.profile_dir_identity),
+                    "session_dir": directory_record(process.session_dir, process.session_dir_identity),
+                    "temporary_dir": directory_record(process.temporary_dir, process.temporary_dir_identity),
+                    "cwd": {"path": case.gate_inputs.cwd},
+                },
+                "runtime": {"model": "openai-codex/gpt-5.6-sol"},
+                "environment": {"exact": dict(process.child_environment)},
+                "limits": {},
+            }
+            with patch.object(phase_driver_module, "verify_tree"), \
+                    patch.object(phase_driver_module, "_load_frontend_deployment", return_value=deployment), \
+                    patch.object(phase_driver_module, "_path_within", return_value=True), \
+                    patch.object(phase_driver_module, "_verify_fixed_file"), \
+                    patch.object(phase_driver_module, "_gate_read", return_value=b"x"):
+                with self.assertRaises(Exception):
+                    phase_driver_module._verify_source_closures(case.config, process, case.gate_inputs)
+        finally:
+            case.tearDown()
+
+    def test_all_source_tree_roots_must_be_pairwise_nonoverlapping(self) -> None:
