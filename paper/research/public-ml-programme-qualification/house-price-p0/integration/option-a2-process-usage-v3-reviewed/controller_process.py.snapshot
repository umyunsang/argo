        return cls(
            provider_timeout_ms=_integer(value["provider_timeout_ms"], "provider_timeout_ms"),
            provider_retries=_integer(value["provider_retries"], "provider_retries"),
            phase_wall_seconds=_number(value["phase_wall_seconds"], "phase_wall_seconds"),
            campaign_wall_seconds=_number(value["campaign_wall_seconds"], "campaign_wall_seconds"),
            cpu_seconds_per_process=_integer(value["cpu_seconds_per_process"], "cpu_seconds_per_process"),
            file_size_bytes=_integer(value["file_size_bytes"], "file_size_bytes"),
            rss_trigger_bytes=_integer(value["rss_trigger_bytes"], "rss_trigger_bytes"),
            rss_sample_ms=_integer(value["rss_sample_ms"], "rss_sample_ms"),
            v8_old_space_mib=_integer(value["v8_old_space_mib"], "v8_old_space_mib"),
            model_tokens_between_turns=_integer(value["model_tokens_between_turns"], "model_tokens_between_turns"),
            controller_turn_limit_per_phase=_integer(value["controller_turn_limit_per_phase"], "controller_turn_limit_per_phase"),
            source_text_max_bytes=_integer(value["source_text_max_bytes"], "source_text_max_bytes"),
            autonomous_gate_retries=_integer(value["autonomous_gate_retries"], "autonomous_gate_retries"),
            autonomous_gate_timeout_ms=_integer(value["autonomous_gate_timeout_ms"], "autonomous_gate_timeout_ms"),
