@dataclass(frozen=True)
class PathIdentity:
    resolved_path: str
    path_kind: str
    device: int
    inode: int
    mode: int
    uid: int
    size: int
    mtime_ns_max: int
    sha256: str | None

    @classmethod
    def from_dict(cls, value: Mapping[str, object]) -> "PathIdentity":
        _require_keys(value, {item.name for item in field_list(cls)}, "path_identity")
        return cls(
            resolved_path=_string(value["resolved_path"], "resolved_path"),
            path_kind=_string(value["path_kind"], "path_kind"),
            device=_integer(value["device"], "device"),
            inode=_integer(value["inode"], "inode"),
            mode=_integer(value["mode"], "mode"),
            uid=_integer(value["uid"], "uid"),
            size=_integer(value["size"], "size"),
            mtime_ns_max=_integer(value["mtime_ns_max"], "mtime_ns_max"),
            sha256=_optional_string(value["sha256"], "sha256"),
        )


@dataclass(frozen=True)
class SymlinkIdentity:
    path: str
    device: int
    inode: int
    mode: int
    uid: int
    link_target: str

    @classmethod
    def from_dict(cls, value: Mapping[str, object]) -> "SymlinkIdentity":
        _require_keys(value, {item.name for item in field_list(cls)}, "symlink_identity")
        return cls(
            path=_string(value["path"], "path"),
            device=_integer(value["device"], "device"),
            inode=_integer(value["inode"], "inode"),
            mode=_integer(value["mode"], "mode"),
            uid=_integer(value["uid"], "uid"),
            link_target=_string(value["link_target"], "link_target"),
        )


@dataclass(frozen=True)
class InterpreterIdentity:
    invocation_path: str
    symlink_chain: tuple[SymlinkIdentity, ...]
    resolved_target: PathIdentity
    pyvenv_cfg_path: str
    pyvenv_cfg: PathIdentity

    @classmethod
    def from_dict(cls, value: Mapping[str, object]) -> "InterpreterIdentity":
        _require_keys(value, {item.name for item in field_list(cls)}, "interpreter_identity")
        chain_value = value["symlink_chain"]
        if not isinstance(chain_value, list):
            raise ValueError("symlink_chain must be an array")
        return cls(
            invocation_path=_string(value["invocation_path"], "invocation_path"),
            symlink_chain=tuple(
                SymlinkIdentity.from_dict(_mapping(item, "symlink_identity"))
                for item in chain_value
            ),
            resolved_target=PathIdentity.from_dict(_mapping(value["resolved_target"], "resolved_target")),
            pyvenv_cfg_path=_string(value["pyvenv_cfg_path"], "pyvenv_cfg_path"),
            pyvenv_cfg=PathIdentity.from_dict(_mapping(value["pyvenv_cfg"], "pyvenv_cfg")),
        )


