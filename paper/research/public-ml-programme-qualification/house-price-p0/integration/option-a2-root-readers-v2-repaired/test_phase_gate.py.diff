+    def test_fresh_gate_invocation_cannot_roll_back_or_forget_completed_usage(self):
+        first=self.call()
+        self.assertEqual(first["usage"]["total_tokens"],3745)
+        session_file=next(self.session.iterdir())
+        earlier=self.native.splitlines(keepends=True)[:-1]
+        session_file.write_bytes(b"".join(earlier))
+        rolled=self.call()
+        self.assertEqual(rolled["decision"]["outcome"],"STOP_USAGE_UNKNOWN")
+        self.assertEqual(rolled["usage"]["total_tokens"],3745)
+        session_file.unlink()
+        missing=self.call()
+        self.assertEqual(missing["decision"]["outcome"],"STOP_USAGE_UNKNOWN")
+
+    def test_outcome_chain_is_contiguous_and_checkpoint_is_exact(self):
+        first=self.call();second=self.call()
+        self.assertEqual(first["sequence"],1);self.assertEqual(second["sequence"],2)
+        outcomes=sorted(self.outcomes.glob("*.json"))
+        self.assertEqual(second["previous_outcome_sha256"],hashlib.sha256(outcomes[0].read_bytes()).hexdigest())
+        self.assertEqual(second["usage_checkpoint"]["observation"],second["usage"])
+        self.assertEqual(second["usage_checkpoint"]["prefix"]["bytes"],len(self.native))
+        outcomes[0].unlink()
+        with self.assertRaises(GateConfigError):self.call()
+
+    def test_corrupt_or_busy_history_fails_closed_without_new_outcome(self):
+        self.call();first=next(self.outcomes.glob("*.json"))
+        first.write_bytes(first.read_bytes().replace(b'"sequence":1',b'"sequence":2'))
+        with self.assertRaises(GateConfigError):self.call()
+        self.assertEqual(len(list(self.outcomes.glob("*.json"))),1)
+        lock=self.outcomes/".gate-evaluation.lock";lock.write_bytes(b"not-this-evaluation")
+        with self.assertRaises(GateConfigError):self.call()
+        self.assertEqual(lock.read_bytes(),b"not-this-evaluation")
+
+    def test_unknown_usage_cannot_be_repaired_into_readiness_on_next_call(self):
+        path=next(self.session.iterdir());path.write_bytes(self.native[:-1])
+        first=self.call();self.assertEqual(first["decision"]["outcome"],"STOP_USAGE_UNKNOWN")
+        path.write_bytes(self.native)
+        second=self.call();self.assertEqual(second["decision"]["outcome"],"STOP_USAGE_UNKNOWN")
+        self.assertFalse(second["decision"]["ready"])
+
+    def test_outcome_count_cap_and_short_write_are_fail_closed(self):
+        native_write=os.write
+        def short_write(fd,data):return native_write(fd,data[:7])
+        with patch("experiments.argo_workflow_followup.public_ml_apparatus.house_price_runtime.phase_gate.os.write",side_effect=short_write):
+            first=self.call()
+        self.assertEqual(first["decision"]["outcome"],"READY_INITIAL_CHECKPOINT")
+        for _ in range(39):self.call()
+        with self.assertRaises(GateConfigError):self.call()
+        self.assertEqual(len(list(self.outcomes.glob("*.json"))),40)
+        self.assertFalse((self.outcomes/".gate-evaluation.lock").exists())
+
+    def test_partial_outcome_write_is_retained_and_blocks_next_invocation(self):
+        native_write=os.write
+        calls=0
+        def interrupted_write(fd,data):
+            nonlocal calls
+            calls+=1
+            if calls==3:raise OSError("synthetic")
+            return native_write(fd,data if calls==1 else data[:11])
+        with patch("experiments.argo_workflow_followup.public_ml_apparatus.house_price_runtime.phase_gate.os.write",side_effect=interrupted_write):
+            with self.assertRaises(GateConfigError):self.call()
+        incomplete=next(self.outcomes.glob("*.json"))
+        self.assertEqual(incomplete.stat().st_size,11)
+        self.assertFalse((self.outcomes/".gate-evaluation.lock").exists())
+        with self.assertRaises(GateConfigError):self.call()
+        self.assertEqual(len(list(self.outcomes.glob("*.json"))),1)
+
