{
  "schema_version": "argo-house-price-controller-bridge/v1",
  "status": "INTERFACE_FOR_IMPLEMENTATION_NOT_PRODUCTION_ADMISSION",
  "request_envelope": "{action: one of six exact tool names, arguments: exact action object}; additionalProperties false",
  "response_envelope": "{ok:true,result: exact per-action result} or {ok:false,error:safe_enum}; additionalProperties false",
  "safe_errors": [
    "INVALID_ARGUMENT",
    "TOOL_SURFACE",
    "PATH_DENIED",
    "SOURCE_LIMIT",
    "HASH_MISMATCH",
    "SOURCE_LOCKED",
    "CONFLICT",
    "INTENT_INVALID",
    "BUDGET_EXHAUSTED",
    "UNCERTAIN_NO_AUTOMATIC_RETRY",
    "RESULT_NOT_READY",
    "RESULT_INVALID",
    "FINAL_SELECTION_REQUIRED",
    "FINAL_LOCKED",
    "BRIDGE_TIMEOUT",
    "BRIDGE_OUTPUT",
    "INTERNAL_ERROR"
  ],
  "results": {
    "read_solution": {
      "path": "solution.py|research.md|intent.json",
      "content": "bounded UTF8 source text only",
      "sha256": "lowercase64hex"
    },
    "write_solution": {
      "path": "solution.py|research.md|intent.json",
      "sha256": "lowercase64hex",
      "bytes": "nonnegative bounded integer"
    },
    "request_R1_run": {
      "intent_sha256": "lowercase64hex",
      "run_id": "uuid",
      "experiment_id": "uuid",
      "solution_sha256": "lowercase64hex",
      "phase": "dev|final_refit"
    },
    "read_public_result": {
      "phase": "development|final_selected|final_locked",
      "dev_attempts": "integer0..4",
      "final_attempts": "integer0..1",
      "remaining_dev_opportunities": "integer0..3",
      "runs": [
        {
          "intent_sha256": "lowercase64hex",
          "run_id": "uuid",
          "experiment_id": "uuid",
          "solution_sha256": "lowercase64hex",
          "phase": "dev|final_refit",
          "status": "QUEUED|RUNNING|DONE|FAILED|CANCELLED|UNKNOWN",
          "artifact_sha256": "optional lowercase64hex, only valid locked-reference output receipt"
        }
      ]
    },
    "read_dev_result": {
      "results": [
        {
          "run_id": "uuid",
          "solution_sha256": "lowercase64hex",
          "valid": true,
          "mae": "finite nonnegative bounded decimal, no scientific notation extra payload",
          "rows": "positive bounded integer"
        }
      ]
    },
    "lock_final_artifact": {
      "run_id": "uuid",
      "artifact_sha256": "lowercase64hex",
      "lock_sha256": "lowercase64hex",
      "solution_sha256": "lowercase64hex"
    }
  },
  "limits": {
    "max_request_bytes": 262144,
    "max_response_bytes": 262144,
    "max_list_items": 5,
    "max_source_content_bytes": 131072,
    "max_path_bytes": 32,
    "max_metric_abs": 1000000000000,
    "max_metric_decimal_places": 6
  },
  "notes": [
    "Raw train/dev/hidden arrays and generated error/stdout never transported. Metric is intentional bounded information channel, not proof of semantic secrecy.",
    "ORX status comes from native status/runs calls, never inferred from local fence/journal. Errors parse unknown maps to safe enum.",
    "Fixed trusted bridge argv/cwd/config; model only JSON action/arguments, no executable/path override.",
    "One final-refit fence typed by trusted selected code+selection+execution config, separate from dev fence; selection precedes final fit."
  ]
}
