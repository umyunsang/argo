{
  "schema_version": "argo-real-decision-packet-contract/v1",
  "created_at": "2026-09-05T20:28:19+09:00",
  "scope": "Retrospective deterministic validation on four canonical real research-state packets. This tests dependency targeting and narrow policy decisions, not model efficacy or external task success.",
  "verdicts": {
    "PASS": "required bytes are intact, claim-relative rule is sufficient, and selected narrow policy decision matches",
    "INCONCLUSIVE": "route may be intact and hold decision may be correct, but evidence is insufficient for the scientific/behavioral claim",
    "INVALID": "wrong route, altered bytes, overclaim, malformed packet, or decision inconsistent with derived facts"
  },
  "axes": [
    "route_fidelity",
    "claim_relative_evidence_sufficiency",
    "policy_decision_correctness",
    "external_task_outcome"
  ],
  "missing_evidence_policy": "INCONCLUSIVE",
  "mismatched_or_wrong_evidence_policy": "INVALID",
  "dependency_targeting": {
    "inference_unit": "decision packet",
    "withdrawal_event": "one required evidence artifact becomes unavailable",
    "selective_rule": "only packets that directly require that artifact are affected",
    "global_comparator": "marks all packets affected",
    "confirmatory_claim": false
  },
  "packets": {
    "external_trace": {
      "adapter": "external_trace",
      "graph_decision_id": "decision:rd_2026_09_05_external_trace",
      "question": "What scope can the architecture trace support?",
      "evidence": {
        "frontier": {
          "path": "paper/research/receipts/external-architecture-trace-frontier-v1.json",
          "sha256": "1d269c19d82a432285030963ef6e99b3f3c06aa76c29c499c85ea9237225c366"
        }
      },
      "rules": [
        {
          "id": "scoped_retrospective_only",
          "when": [
            {
              "fact": "official_log_to_csv_byte_exact",
              "op": "eq",
              "value": true
            },
            {
              "fact": "scoped_exact",
              "op": "eq",
              "value": 3
            },
            {
              "fact": "nested_pairs",
              "op": "eq",
              "value": 3
            },
            {
              "fact": "inference_units",
              "op": "eq",
              "value": 1
            },
            {
              "fact": "training_code_present",
              "op": "eq",
              "value": false
            }
          ],
          "decision": "ADMIT_SCOPED_RETROSPECTIVE_APPLICABILITY_ONLY",
          "sufficiency": "SUFFICIENT_FOR_NARROW_RETROSPECTIVE_SCOPE"
        }
      ],
      "default": {
        "decision": "HOLD_INCONCLUSIVE",
        "sufficiency": "INCONCLUSIVE"
      },
      "claim_expectations": {
        "inference_units": 1,
        "external_task_outcome": "NOT_MEASURED"
      }
    },
    "grounded_physics": {
      "adapter": "grounded_physics",
      "graph_decision_id": "decision:rd_2026_09_05_grounded_physics_trace",
      "question": "What public-archive scope can the grounded-physics package support?",
      "evidence": {
        "audit": {
          "path": "paper/research/grounded-physics-trace-audit.json",
          "sha256": "c9235035fb014af7da7027263bc2ed31466ff557ad9e6a9932faf08a48886546"
        }
      },
      "rules": [
        {
          "id": "aggregate_only",
          "when": [
            {
              "fact": "archive_audit_passed",
              "op": "eq",
              "value": true
            },
            {
              "fact": "aggregate_byte_exact",
              "op": "eq",
              "value": true
            },
            {
              "fact": "episode_rows",
              "op": "eq",
              "value": 15
            },
            {
              "fact": "direct_source_closed_rows",
              "op": "eq",
              "value": 0
            },
            {
              "fact": "raw_transcripts_published",
              "op": "eq",
              "value": false
            }
          ],
          "decision": "ADMIT_AGGREGATE_REJECT_RAW_DECISION_GRAPH",
          "sufficiency": "SUFFICIENT_FOR_AGGREGATE_AND_LIMITATION_ONLY"
        }
      ],
      "default": {
        "decision": "HOLD_INCONCLUSIVE",
        "sufficiency": "INCONCLUSIVE"
      },
      "claim_expectations": {
        "inference_units": 1,
        "episode_rows": 15,
        "direct_source_closed_rows": 0,
        "external_task_outcome": "NOT_MEASURED"
      }
    },
    "discoveryworld": {
      "adapter": "discoveryworld",
      "graph_decision_id": "decision:rd_2026_09_05_discoveryworld_pack",
      "question": "Is the DiscoveryWorld behavioral pack admitted now?",
      "evidence": {
        "validation": {
          "path": "paper/research/receipts/discoveryworld-pack-design-validation-v1.json",
          "sha256": "c881dcdd40d7d39b29427b2687bc265dedb7dd7190def2ce3263d7f94ef1432c"
        },
        "source_audit": {
          "path": "paper/research/discoveryworld-source-audit.json",
          "sha256": "261f67ab058081216efbde8d2d738ed4e9360453460d01d92739800aa9871baa"
        },
        "design": {
          "path": "experiments/argo_workflow_followup/discoveryworld_pack/pack-design.json",
          "sha256": "64696338be6020b667e2a1f76dfa1f9bd4726c57316ca68e42423de5ef2c695a"
        },
        "gold_contract": {
          "path": "experiments/argo_workflow_followup/discoveryworld_pack/gold-generation-contract.json",
          "sha256": "834e108e5a53bb88ca34c1ac19fa80dd45b417226c2e2c575bac249939a7b5d9"
        }
      },
      "rules": [
        {
          "id": "designed_not_admitted",
          "when": [
            {
              "fact": "schema_validation_passed",
              "op": "eq",
              "value": true
            },
            {
              "fact": "task_rows",
              "op": "eq",
              "value": 10
            },
            {
              "fact": "inference_units",
              "op": "eq",
              "value": 2
            },
            {
              "fact": "runner_present",
              "op": "eq",
              "value": false
            },
            {
              "fact": "gold_generated",
              "op": "eq",
              "value": false
            },
            {
              "fact": "source_admitted",
              "op": "eq",
              "value": false
            }
          ],
          "decision": "DO_NOT_ADMIT_BEHAVIORAL_PACK",
          "sufficiency": "INCONCLUSIVE_FOR_BEHAVIORAL_ADMISSION"
        }
      ],
      "default": {
        "decision": "HOLD_INCONCLUSIVE",
        "sufficiency": "INCONCLUSIVE"
      },
      "claim_expectations": {
        "inference_units": 2,
        "seed_rows": 10,
        "external_task_outcome": "NOT_MEASURED"
      }
    },
    "isolation_canary": {
      "adapter": "isolation_canary",
      "graph_decision_id": "decision:rd_2026_09_05_isolation_canary_v2",
      "question": "Does current evidence establish effective OS isolation?",
      "evidence": {
        "readiness": {
          "path": "paper/research/receipts/isolation-canary-v2-readiness.json",
          "sha256": "c9b2119b9a0598f3c9cbfc42eadd232500cd36419f05df349d507cea48e49f2d"
        },
        "approval": {
          "path": "experiments/argo_workflow_followup/isolation_canary_v2/approval-template.json",
          "sha256": "3b61f8bf444da172bb1389fca2d5c5c4f204cb2efba2c2a9b6ce78d69432343b"
        }
      },
      "rules": [
        {
          "id": "ready_unapproved_unobserved",
          "when": [
            {
              "fact": "readiness_validated",
              "op": "eq",
              "value": true
            },
            {
              "fact": "approval_present",
              "op": "eq",
              "value": false
            },
            {
              "fact": "container_launches",
              "op": "eq",
              "value": 0
            }
          ],
          "decision": "DO_NOT_CLAIM_ISOLATION_AWAIT_APPROVAL",
          "sufficiency": "INCONCLUSIVE_FOR_OS_ISOLATION"
        }
      ],
      "default": {
        "decision": "INVALID_IF_PROMOTED",
        "sufficiency": "INCONCLUSIVE"
      },
      "claim_expectations": {
        "container_launches": 0,
        "external_task_outcome": "NOT_MEASURED"
      }
    }
  },
  "limits": [
    "Rules were authored retrospectively against four known programmes.",
    "Four packets are not a population estimate and do not support efficacy.",
    "A correct hold/restriction decision is not evidence that a later task will succeed.",
    "Artifact topology checks do not establish semantic truth of the source summaries.",
    "External architecture pairs are nested within one programme; DiscoveryWorld seeds are nested within two families."
  ]
}
