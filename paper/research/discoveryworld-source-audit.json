  "admissibility": {
    "decision": "CONDITIONAL_BASE_ENVIRONMENT_NOT_ADMITTED_WORKFLOW_TASK_SOURCE",
    "usable_now": [
      "pinned source audit",
      "zero-cost text-only task loading",
      "rule-derived completion/procedural scoring",
      "task/seed enumeration"
    ],
    "excluded": [
      "visual observations as a deterministic primary",
      "explanatory-knowledge score",
      "arbitrary filesystem or Python tools for the agent",
      "any model run",
      "upstream procedural score as a standalone primary policy judge",
      "claims of hidden-task generalization"
    ],
    "blockers": [
      "same-seed rendered pixels were not exact, so the current primary must be text-only",
      "the public evaluator method and oracle-bearing scenario code share the agent process; a separate sandbox boundary is not implemented",
      "scenario seeding does not seal every RNG path; unseeded object and NPC random sources exist",
      "official seed conventions disagree across two supplied runners, so literal API seeds must be frozen",
      "some action-history procedure queries do not require successful actions, so procedure score remains secondary and audited per selected task",
      "the public benchmark has task spoilers; only runtime gold isolation, not pretrained non-exposure, is enforceable",
      "upstream dependencies are unpinned; the measured local resolution is not an immutable cross-platform environment",
      "no frozen correction/handoff event pack maps task evidence to an independently authored decision-choice oracle",
      "no fixed runner, admitted task sample, exact resource envelope, or model-execution approval exists"
    ],
    "routing_sufficiency_implication": "DiscoveryWorld can supply an external end-to-end outcome, preventing route correctness from substituting for task success. It does not by itself supply a correction/reopening oracle or prove that a routed packet is decision-sufficient.",
    "runtime_classification": "OPEN_BOOK_SOURCE_RUNTIME_ISOLATION_REQUIRED"
  },
