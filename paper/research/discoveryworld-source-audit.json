  "source_derived_facts": [
    {
      "fact": "SCENARIO_INFOS exposes 8 discovery themes, each with Easy/Normal/Challenge and five listed variations, plus 10 unit-test themes.",
      "locator": "discoveryworld/ScenarioMaker.py; README.md §§3.3.1-3.3.3"
    },
    {
      "fact": "getAgentObservation returns task status but no fine-grained scorecard in the measured Proteomics observation.",
      "locator": "discoveryworld/DiscoveryWorldAPI.py:128-218; README.md:158-182"
    },
    {
      "fact": "getTaskScorecard is a public API method and explicitly documented as oracle-bearing information that must not be shown to an agent.",
      "locator": "discoveryworld/DiscoveryWorldAPI.py:232-240"
    },
    {
      "fact": "task completion and normalized procedural scores are computed from task update rules and serialized separately from the agent-facing task progress.",
      "locator": "discoveryworld/TaskScorer.py:1-143 and task-specific updateTick implementations"
    },
    {
      "fact": "the optional explanatory-knowledge scorer calls OpenAI and checks a local key file or OPENAI_API_KEY. It is excluded from the proposed deterministic primary.",
      "locator": "scripts/knowledgeScorer.py:14-102"
    },
    {
      "fact": "The minimal agent task view contains description and terminal booleans, while the full public scorecard method exposes oracle-bearing details. Isolation is a runner responsibility, not an API capability boundary.",
      "locator": "discoveryworld/UserInterface.py:444-460; discoveryworld/DiscoveryWorldAPI.py:232-240"
    },
    {
      "fact": "Object construction creates an unseeded random.Random(), radiation measurements use that object RNG, and NPC wandering calls module-global random. Seeded scenario generation therefore does not imply deterministic full trajectories.",
      "locator": "discoveryworld/objects/Object.py:15-20; discoveryworld/objects/ScienceTools.py:305-319; discoveryworld/Pathfinding.py:750-764"
    },
    {
      "fact": "README defines official seeds as literal 0..4, but SCENARIO_INFOS stores strings 1..5; RandomAgent subtracts one while the ReComA loader does not. A future manifest must freeze literal API seed values rather than inherit a loader convention.",
      "locator": "README.md:148-150; discoveryworld/ScenarioMaker.py:63-139; agents/RandomAgent.py:345-352; agents/recoma/discoveryworld_env_models.py:173-186"
    },
    {
      "fact": "Action history stores success, but queryActionObjects does not filter on it and task-specific procedural scorecards call that helper. Some procedure credit can therefore be triggered by an unsuccessful attempt.",
      "locator": "discoveryworld/ActionHistory.py:98-165; discoveryworld/TaskScorer.py task-specific updateTick implementations"
    },
    {
      "fact": "The paper and repository are public and README explicitly warns that the paper contains task spoilers. Runtime oracle isolation cannot establish that a pretrained model has never seen task answers.",
      "locator": "README.md:13-24"
    },
    {
      "fact": "The environment action surface contains no native source-version correction, dependency invalidation, selective reopening, successor-choice, or fresh-context handoff operation. Those would be an ARGO-derived evaluation layer, not an official DiscoveryWorld feature.",
      "locator": "discoveryworld/ActionHistory.py:1-86 and DiscoveryWorldAPI.py action interface"
    }
  ],
  "paper_derived_facts": [
    {
      "fact": "The official benchmark is 8 themes × 3 difficulties × 5 seeds = 120 tasks; parametric variation is deterministic under a single seed.",
      "locator": "full text lines 300-310"
    },
    {
      "fact": "task completion and procedural process are automatic; explanatory knowledge is manually or LLM graded.",
      "locator": "full text lines 342-355"
    },
    {
      "fact": "each task is independent in the reported zero-shot setting; Easy uses 100 steps and Normal/Challenge use 1000.",
      "locator": "full text lines 360-374"
    },
    {
      "fact": "reported agent component/procedural competence did not imply end-to-end discovery success.",
      "locator": "full text lines 497-505"
    },
    {
      "fact": "the simulator is low fidelity and performance does not imply real-world discovery performance.",
      "locator": "full text lines 725-739"
    }
  ],
