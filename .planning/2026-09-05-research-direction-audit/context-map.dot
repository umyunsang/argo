digraph audit {
  graph [rankdir=LR, bgcolor="white", pad="0.3", nodesep="0.38", ranksep="0.7", fontname="Helvetica", fontsize=19, labelloc="t", label="Research Direction: Evidence and Decision Map\n2026-09-05  |  Private audit  |  DRAFT - NOT APPLIED"];
  node [shape=box, style="rounded", color="black", fontname="Helvetica", fontsize=12, margin="0.16,0.12", penwidth=1.1];
  edge [color="black", arrowsize=0.65, fontname="Helvetica", fontsize=10];
  subgraph cluster_evidence {
    label="OBSERVED / REVIEWED EVIDENCE"; fontsize=13; color="#777777"; style=rounded;
    literature [label="Primary methods\nResult trees / selective memory\nScoped reading; no local efficacy"];
    experiment [label="Frozen C design\n16 tasks x 2 policies x 2 blocks\nAllocation, not complete R&D"];
    handoff [label="Active handoff snapshot\nROOT hash mismatch\nConsumer acceptance not run"];
    authority [label="Separate authorities\nC cap: 64 attempted episodes\nNative / publication holds"];
  }
  subgraph cluster_decisions {
    label="REVIEW DECISIONS / PROPOSED FOLLOW-UP"; fontsize=13; color="#777777"; style=rounded;
    freeze [label="PRESERVE CURRENT C\nNo interim adaptation\nPrimary != reliability replication", style="rounded,filled", fillcolor="#eeeeee"];
    baseline [label="STRONG SIMPLER CONTROL\nSame evidence and opportunity\nAdaptive result-tree / index", style="rounded,dashed"];
    mechanism [label="ISOLATE THE MECHANISM\nInitial record vs persistent control\nNew diagnostic only if needed", style="rounded,dashed"];
    domain [label="BRIDGE TO REAL RESEARCH\nNext action / selective recheck\nFresh-context handoff", style="rounded,dashed"];
    capsule [label="ONE COHERENT REVISION\nImmutable source + attempt blobs\nScoped invalidation / exclusions", style="rounded,dashed"];
    boundary [label="RETAIN BOUNDARIES\nPaper != internal product plan\nNo native restart or publication", style="rounded,filled", fillcolor="#eeeeee"];
  }
  verdict [shape=box, penwidth=2, label="VERDICT\nDirection is defensible\nSuperiority is NOT established\n\nChoose simpler design if matched\nRequire evidence at claimed scope"];
  future [shape=box, penwidth=2, label="SEPARATE ADMISSION REQUIRED\nNo new runs or canonical edits\nNo runtime or manuscript edits\nThis map grants no authority"];
  experiment -> freeze [label="frozen"];
  experiment -> mechanism [label="claim limit"];
  experiment -> domain [label="coverage gap"];
  literature -> baseline [label="comparator"];
  literature -> domain [label="task validity"];
  handoff -> capsule [label="recheck"];
  authority -> freeze [label="exact cap"];
  authority -> boundary [label="holds"];
  baseline -> verdict;
  mechanism -> verdict;
  domain -> verdict;
  freeze -> verdict [label="not yet proof"];
  capsule -> future;
  boundary -> future;
  baseline -> future [style=dashed];
  domain -> future [style=dashed];
  { rank=same; verdict; future; }
}
