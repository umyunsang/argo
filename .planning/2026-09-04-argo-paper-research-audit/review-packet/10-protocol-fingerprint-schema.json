{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "argo-gcf-protocol-fingerprint-schema/v1",
  "title": "ARGO GCF protocol fingerprint",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "created_at",
    "actor",
    "research_question",
    "file_bindings",
    "benchmark",
    "task_split",
    "randomization",
    "scorer",
    "environment",
    "treatment_model",
    "interfaces",
    "retrieval",
    "retry_and_stopping",
    "resource_caps",
    "analysis",
    "stage0",
    "human_approval",
    "protocol_fingerprint",
    "hash_dependency_rule"
  ],
  "properties": {
    "schema_version": {
      "const": "argo-gcf-protocol-fingerprint/v1"
    },
    "status": {
      "enum": [
        "DRAFT_BLOCKED",
        "SEALED_APPROVED"
      ]
    },
    "created_at": {
      "type": "string"
    },
    "actor": {
      "type": "string"
    },
    "research_question": {
      "type": "object"
    },
    "file_bindings": {
      "type": "array",
      "minItems": 10
    },
    "benchmark": {
      "type": "object"
    },
    "task_split": {
      "type": "object"
    },
    "randomization": {
      "type": "object"
    },
    "scorer": {
      "type": "object"
    },
    "environment": {
      "type": "object"
    },
    "treatment_model": {
      "type": "object"
    },
    "interfaces": {
      "type": "object"
    },
    "retrieval": {
      "type": "object"
    },
    "retry_and_stopping": {
      "type": "object"
    },
    "resource_caps": {
      "type": "object"
    },
    "analysis": {
      "type": "object"
    },
    "stage0": {
      "type": "object"
    },
    "human_approval": {
      "type": "object"
    },
    "protocol_fingerprint": {
      "type": [
        "string",
        "null"
      ]
    },
    "hash_dependency_rule": {
      "const": "acyclic: template may bind graph overlay; graph overlay must not bind template hash"
    }
  },
  "additionalProperties": false
}
