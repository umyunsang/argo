<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" default-locale="en-US" demote-non-dropping-particle="sort-only" page-range-format="expanded">
  <info>
    <title>ARGO graduation-thesis template</title>
    <id>urn:argo:csl:thesis-template</id>
    <link href="urn:argo:csl:thesis-template" rel="self"/>
    <category citation-format="numeric"/>
    <category field="engineering"/>
    <summary>First-citation-order references with superscript bracketed citations and journal/proceedings formatting from the supplied graduation-thesis template. Retains supplied contributor, publication, date, DOI, and URL metadata; preserves title capitalization from the reviewed display bibliography.</summary>
    <updated>2026-09-05T00:00:00+09:00</updated>
  </info>
  <locale>
    <style-options punctuation-in-quote="true"/>
    <terms>
      <term name="page-range-delimiter">-</term>
      <term name="and">and</term>
      <term name="editor" form="short">
        <single>ed.</single>
        <multiple>eds.</multiple>
      </term>
      <term name="page" form="short">
        <single>p.</single>
        <multiple>pp.</multiple>
      </term>
      <term name="open-quote">“</term>
      <term name="close-quote">”</term>
      <term name="open-inner-quote">‘</term>
      <term name="close-inner-quote">’</term>
      <term name="month-01">January</term>
      <term name="month-02">February</term>
      <term name="month-03">March</term>
      <term name="month-04">April</term>
      <term name="month-05">May</term>
      <term name="month-06">June</term>
      <term name="month-07">July</term>
      <term name="month-08">August</term>
      <term name="month-09">September</term>
      <term name="month-10">October</term>
      <term name="month-11">November</term>
      <term name="month-12">December</term>
    </terms>
  </locale>
  <macro name="author">
    <names variable="author">
      <name initialize-with=". " and="text" delimiter=", " delimiter-precedes-last="always"/>
      <substitute>
        <names variable="editor">
          <name initialize-with=". " and="text" delimiter=", " delimiter-precedes-last="always"/>
          <label form="short" prefix=", "/>
        </names>
      </substitute>
    </names>
  </macro>
  <macro name="editor">
    <choose>
      <if variable="author">
        <names variable="editor">
          <name initialize-with=". " and="text" delimiter=", " delimiter-precedes-last="always"/>
          <label form="short" prefix=", "/>
        </names>
      </if>
    </choose>
  </macro>
  <macro name="volume-issue">
    <group delimiter=", ">
      <text variable="volume" prefix="Vol."/>
      <text variable="issue" prefix="No."/>
      <text variable="collection-number" prefix="No."/>
    </group>
  </macro>
  <macro name="publisher">
    <group delimiter=": ">
      <text variable="publisher-place"/>
      <text variable="publisher"/>
    </group>
  </macro>
  <macro name="page">
    <choose>
      <if type="article-journal">
        <text variable="page" prefix="pp."/>
      </if>
      <else>
        <text variable="page" prefix="pp. "/>
      </else>
    </choose>
  </macro>
  <macro name="issued">
    <date variable="issued">
      <date-part name="month" form="long" suffix=" "/>
      <date-part name="day" suffix=", "/>
      <date-part name="year"/>
    </date>
  </macro>
  <macro name="access">
    <group delimiter="; ">
      <text variable="DOI" prefix="doi: "/>
      <text variable="URL" prefix="Available: "/>
    </group>
  </macro>
  <macro name="citation-locator">
    <group delimiter=" ">
      <label variable="locator" form="short"/>
      <text variable="locator"/>
    </group>
  </macro>
  <citation>
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout delimiter=", " vertical-align="sup">
      <group prefix="[" suffix="]" delimiter=", ">
        <text variable="citation-number"/>
        <text macro="citation-locator"/>
      </group>
    </layout>
  </citation>
  <bibliography entry-spacing="0" second-field-align="flush">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout>
      <text variable="citation-number" prefix="[" suffix="]"/>
      <group delimiter=". " suffix=".">
        <group delimiter=", ">
          <text macro="author"/>
          <text variable="title" quotes="true"/>
          <text variable="container-title" font-style="italic"/>
          <text variable="event-place"/>
          <text macro="editor"/>
          <text variable="collection-title" font-style="italic"/>
          <text macro="volume-issue"/>
          <text macro="publisher"/>
          <text macro="page"/>
          <text macro="issued"/>
        </group>
        <text macro="access"/>
      </group>
    </layout>
  </bibliography>
</style>
