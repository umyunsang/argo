{
  "schema_version": "argo-owner-port-design/v1",
  "status": "DESIGN_ONLY_NOT_RUNTIME_CERTIFICATION",
  "owners": [
    {
      "id": "process_session",
      "owner": "Prime/Pi daemon + AgentSession",
      "class": "FIXED_SUBSTRATE",
      "input": [
        "session request",
        "tool invocation",
        "RLM message"
      ],
      "output": [
        "session/tool event",
        "process status",
        "best-effort snapshot receipt"
      ],
      "must_not": [
        "own scientific truth",
        "replay uncertain scientific mutation automatically"
      ],
      "state": "INHERITED_NOT_SCIENTIFICALLY_CERTIFIED"
    },
    {
      "id": "discovery",
      "owner": "research-plane DiscoveryPort",
      "class": "COMMON_SERVICE",
      "input": [
        "query",
        "permitted corpus/provider",
        "retrieval budget"
      ],
      "output": [
        "DiscoveredSourceCandidate: URL, metadata, query, timestamp, provider"
      ],
      "must_not": [
        "emit VERIFIED_CLAIM",
        "write paper snapshot"
      ],
      "state": "INTERFACE_DESIGN_ONLY"
    },
    {
      "id": "source_evidence",
      "owner": "SourceEvidenceService",
      "class": "COMMON_SERVICE",
      "input": [
        "retrieved original bytes",
        "version",
        "actual read scope/locator"
      ],
      "output": [
        "SourceEvidence: bytes hash, exact source/version, locator, provenance and read status"
      ],
      "must_not": [
        "treat snippet as paper support",
        "assert source validity from digest alone"
      ],
      "state": "PARTLY_SPECIFIED_NOT_NATIVE_IMPLEMENTED"
    },
    {
      "id": "audit_history",
      "owner": "ResearchEventStore + deterministic audit projection",
      "class": "COMMON_INSTRUMENT",
      "input": [
        "frozen objective",
        "selected candidate manifest",
        "source/run/assessment events"
      ],
      "output": [
        "append-only evidence history",
        "neutral audit graph hidden from treatment-specific decisions"
      ],
      "must_not": [
        "be a second process supervisor",
        "be an independent scientific-run registry"
      ],
      "state": "JSON_FIXTURE_ONLY_NOT_NATIVE_EVENT_STORE"
    },
    {
      "id": "active_research_control",
      "owner": "candidate B/C/G research policy",
      "class": "EXPERIMENTAL_POLICY",
      "input": [
        "same source/run facts and permitted public observations",
        "current requirements"
      ],
      "output": [
        "next-decision proposal",
        "preservation/recheck set",
        "continuation capsule"
      ],
      "must_not": [
        "edit scorer/authority/budget",
        "use hidden scores",
        "delete adverse evidence"
      ],
      "state": "CANDIDATES_NOT_EXECUTION_READY"
    },
    {
      "id": "scientific_run",
      "owner": "ORX/OpenResearch",
      "class": "EXTERNAL_RUN_AUTHORITY",
      "input": [
        "frozen project/experiment identity",
        "code/config/environment/command",
        "authorized resource envelope"
      ],
      "output": [
        "external run ID/status",
        "logs/artifacts/terminal receipt"
      ],
      "must_not": [
        "transfer ownership to graph projection",
        "promise undocumented remote idempotency"
      ],
      "state": "PER_TASK_INTERFACE_CERTIFICATION_REQUIRED"
    },
    {
      "id": "run_adapter",
      "owner": "ResearchRunAdapter",
      "class": "IDENTITY_TRANSLATION",
      "input": [
        "RunIntent",
        "external response/status",
        "receipt bytes"
      ],
      "output": [
        "bound run identity",
        "reconciliation state",
        "immutable artifact references"
      ],
      "must_not": [
        "perform blind retry",
        "convert UNKNOWN into failure or not-run",
        "start another lifecycle database"
      ],
      "state": "DESIGN_ONLY"
    },
    {
      "id": "final_scorer",
      "owner": "trusted isolated deterministic task scorer",
      "class": "FIXED_MEASUREMENT",
      "input": [
        "opaque preselected artifact ID",
        "fixed evaluation manifest",
        "sealed hidden test/data inside scorer boundary"
      ],
      "output": [
        "typed score/validity receipt"
      ],
      "must_not": [
        "expose hidden contents to agents",
        "inspect treatment-labelled research trace for primary score",
        "select candidate",
        "mutate scientific graph"
      ],
      "state": "TASK_SPECIFIC_SCORER_NOT_SELECTED"
    },
    {
      "id": "critic",
      "owner": "bounded model or human critique role",
      "class": "COMMON_DEVELOPMENT_FEEDBACK",
      "input": [
        "public candidate evidence permitted by protocol"
      ],
      "output": [
        "critique/suggested check, not final truth"
      ],
      "must_not": [
        "be called independent solely because it is another RLM child",
        "access hidden evaluation"
      ],
      "state": "SEPARATE_FROM_FINAL_SCORER"
    },
    {
      "id": "research_refine",
      "owner": "research decision lineage",
      "class": "CANDIDATE_POLICY",
      "input": [
        "admissible observations and unresolved questions"
      ],
      "output": [
        "successor hypothesis/design/decision with retained predecessor"
      ],
      "must_not": [
        "rewrite old outcome",
        "edit engine/evaluator under same scientific contrast"
      ],
      "state": "PROSPECTIVE"
    },
    {
      "id": "engine_refine",
      "owner": "Continual Harness / later engine-promotion lineage",
      "class": "DEFERRED",
      "input": [
        "repeated harness defect evidence",
        "held-out evaluation"
      ],
      "output": [
        "separately versioned patch and promotion/rejection"
      ],
      "must_not": [
        "change frozen study implementation mid-confirmation",
        "inherit empirical credit from research-refine"
      ],
      "state": "NOT_AUTHORIZED_NATIVE_PAUSE"
    },
    {
      "id": "paper",
      "owner": "read-only PaperService / manuscript construction after ResearchDone",
      "class": "DOWNSTREAM_VIEW",
      "input": [
        "closed PaperEvidenceSnapshot",
        "ArchitectureSelectionRecord",
        "human author/release authority"
      ],
      "output": [
        "claim-bound manuscript then checked render"
      ],
      "must_not": [
        "search literature during evidence render",
        "edit scientific decisions",
        "publish internal prototype roadmap"
      ],
      "state": "WRITING_GATE_CLOSED"
    }
  ],
  "run_reconciliation": {
    "states": [
      "RUN_INTENT_FROZEN",
      "LAUNCH_REQUESTED",
      "RECONCILING",
      "RUN_ID_BOUND",
      "TERMINAL_RECEIPT_IMPORTED",
      "UNKNOWN",
      "BLOCKED"
    ],
    "key_fields": [
      "internal_intent_id",
      "protocol_fingerprint",
      "source_revision",
      "external_provider",
      "external_run_id_optional",
      "request_digest",
      "authority_digest",
      "raw_response_digest"
    ],
    "known_external_capabilities": "orx exp status by experiment and orx runs by project observed; stable request-ID lookup/idempotent submit NOT_VERIFIED",
    "after_crash": "query and validate available authoritative identity. If evidence cannot distinguish pending/started/not-found, remain UNKNOWN/BLOCKED; no automatic repeat.",
    "dedup_scope": "at-most-once local receipt binding by exact provider/run/artifact identity; not exactly-once remote execution",
    "negative_tests_required": [
      "missing reply after successful launch",
      "timeout before identity binding",
      "duplicate terminal receipt",
      "conflicting provider/run identity",
      "stale protocol",
      "false not-found",
      "lost nonserializable REPL state",
      "corrupt middle event",
      "no-owner/dual-owner transition"
    ]
  },
  "fixed_vs_candidate_rule": "Only research policy varies in the scientific comparison; common services remain capability and identity matched.",
  "prototype": "future ARGO migration from Prime; no independent wrapper or native implementation in this revision"
}
