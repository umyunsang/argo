ARG BASE_IMAGE=sha256:cd43d0d8edac942bd67cd097caf08edd2def45016bf011c1635849f15ebc7835
FROM ${BASE_IMAGE}
USER 0:0
COPY requirements-kernel.txt /opt/kernel-build/requirements-kernel.txt
COPY prime-agent-runtime /opt/prime-agent-runtime
RUN python -m pip install --no-cache-dir -r /opt/kernel-build/requirements-kernel.txt && \
    python -m pip install --no-cache-dir --no-deps /opt/prime-agent-runtime && \
    python -m pip check && \
    python -m pip freeze > /opt/kernel-build/installed-requirements.txt && \
    python -c "import rlm.repl, sklearn, pandas, numpy, scipy; assert rlm.repl.PROTOCOL_VERSION == 3; assert sklearn.__version__ == '1.6.1'; assert pandas.__version__ == '2.2.3'; assert numpy.__version__ == '1.26.4'; assert scipy.__version__ == '1.14.1'"
ENV HOME=/tmp XDG_CACHE_HOME=/tmp/.cache PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
USER 65532:65532
ENTRYPOINT ["python"]
CMD ["-m", "rlm.repl"]
